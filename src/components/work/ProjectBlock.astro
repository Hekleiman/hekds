---
import ProjectFrame from '../ui/ProjectFrame.astro';
import { portfolioImageFor } from '../../lib/portfolioImages';

interface Props {
  title: string;
  slug: string;
  category: string;
  year: string;
  description: string;
  tags: string[];
  thumbnail?: string;
  index?: number;
  imageLeft?: boolean;
  class?: string;
}

const {
  title,
  slug,
  category,
  year,
  description,
  tags,
  thumbnail,
  index = 0,
  imageLeft = true,
  class: className,
} = Astro.props;

// Prefer the real, chrome-ready screenshot; fall back to a Sanity thumbnail.
const mapped = portfolioImageFor({ slug, title });
const frameSrc = mapped?.src ?? thumbnail;
const numeral = String(index + 1).padStart(2, '0');

// Right-size via srcset (an 880px card covers the half-width card slot); the four
// real projects have -card variants. The first row loads eagerly (LCP), rest lazy.
const CARDS = new Set(['jewmanity', 'lisette', 'tradeup', 'yieldstone']);
const frameBase = frameSrc?.split('/').pop()?.replace('.webp', '');
const frameSrcset =
  frameSrc && frameBase && CARDS.has(frameBase)
    ? `${frameSrc.replace('.webp', '-card.webp')} 880w, ${frameSrc} 1600w`
    : undefined;
const eager = index === 0;
---

<a
  href={`/work/${slug}`}
  class:list={[
    'project-block group grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-20 items-center',
    className,
  ]}
  aria-label={`View project — ${title}`}
>
  <!-- Image column (framed screenshot in device chrome) -->
  <div class:list={['relative', !imageLeft && 'md:order-2']}>
    {frameSrc ? (
      <ProjectFrame
        variant={mapped?.variant ?? 'browser'}
        src={frameSrc}
        srcset={frameSrcset}
        alt={`${title} — ${category}, built by HEK Design Studio`}
        url={mapped?.url}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
    ) : (
      <div class="surface-elevated aspect-[16/10] flex items-center justify-center text-text-placeholder">
        <span class="text-caption">{title}</span>
      </div>
    )}
  </div>

  <!-- Text column -->
  <div class:list={['flex flex-col', !imageLeft ? 'md:order-1 md:pr-6' : 'md:pl-6']}>
    <!-- Metallic index numeral — fluidly scales 44 → 64px (matching Home's
         process numbers on desktop) instead of jumping at one breakpoint. -->
    <span class="project-numeral text-metallic block leading-none font-semibold tabular-nums mb-4">
      {numeral}
    </span>

    <!-- Category + year -->
    <p class="text-caption uppercase tracking-[0.2em] text-accent-bronze-bright/80 mb-3">
      {category} <span class="text-text-muted">· {year}</span>
    </p>

    <!-- Title -->
    <h2 class="text-h2 text-white mb-4">
      {title}
    </h2>

    <!-- Description -->
    <p class="text-body-lg text-text-secondary max-w-[520px] mb-6">
      {description}
    </p>

    <!-- Tags -->
    {tags?.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-7">
        {tags.map((tag) => (
          <span class="inline-flex items-center rounded-full border border-border-primary bg-background-secondary/60 px-3.5 py-1 text-caption text-text-muted">
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- View affordance -->
    <span class="inline-flex items-center gap-2 text-caption font-medium text-white">
      <span class="plink-label">View project</span>
      <span class="plink-arrow transition-transform duration-300 ease-out group-hover:translate-x-1">→</span>
    </span>
  </div>
</a>

<style>
  .project-numeral {
    font-size: clamp(2.75rem, 1.9rem + 3.2vw, 4rem); /* 44 → 64px */
  }

  .plink-label {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.4s var(--ease-out-expo);
    padding-bottom: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .project-block:hover .plink-label {
      background-size: 100% 1px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plink-label { transition: none; }
    .plink-arrow { transition: none; }
  }
</style>
