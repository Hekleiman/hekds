---
import Section from '../ui/Section.astro';
import ProjectFrame from '../ui/ProjectFrame.astro';
import type { Project } from '../../data/projects';
import { portfolioImageFor, type GalleryShot } from '../../lib/portfolioImages';

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className } = Astro.props;

const mapped = portfolioImageFor({ slug: project.slug, title: project.title });
const primarySrc = mapped?.src ?? project.thumbnail;

// Prefer Sanity images when populated; otherwise fall back to the mapped gallery.
const gallery: GalleryShot[] =
  project.images && project.images.length > 0
    ? project.images.map((src, i) => ({ src, label: `Screen ${i + 1}`, type: 'browser' as const }))
    : mapped?.gallery ?? [];

// A gallery is a "device" gallery when every slide is a phone — it becomes a row
// on desktop; browser galleries stack. Both are a one-at-a-time carousel on mobile.
const isPhoneGallery = gallery.length > 0 && gallery.every((g) => g.type === 'phone');

const liveUrl = mapped?.url;

// Right-size the primary via srcset: an 880px card for small viewports, the full
// 1600px for large. Only the four real projects have -card variants on disk.
const PRIMARY_CARDS = new Set(['jewmanity', 'lisette', 'tradeup', 'yieldstone']);
const primaryBase = primarySrc?.split('/').pop()?.replace('.webp', '');
const primarySrcset =
  primarySrc && primaryBase && PRIMARY_CARDS.has(primaryBase)
    ? `${primarySrc.replace('.webp', '-card.webp')} 880w, ${primarySrc} 1600w`
    : undefined;
---

<Section class:list={['pt-0!', className]}>
  <!-- Primary framed shot — the "money shot", in browser chrome -->
  {primarySrc && (
    <div class="relative mb-16 md:mb-24 group" data-animate="fade-up">
      <div class="aura w-[70%] h-[60%] top-[10%] left-1/2 -translate-x-1/2 bg-accent-bronze/[0.07]"></div>
      <div class="relative max-w-[980px] mx-auto">
        <ProjectFrame
          variant={mapped?.variant ?? 'browser'}
          src={primarySrc}
          srcset={primarySrcset}
          alt={`${project.title} — ${project.category}, built by HEK Design Studio`}
          url={mapped?.url}
          width={1600}
          height={1000}
          loading="eager"
          fetchpriority="high"
          sizes="(min-width: 1024px) 980px, 100vw"
          shine
        />
      </div>
    </div>
  )}

  <!-- Overview: lead paragraph + a meta card (services, live link) -->
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16" data-animate="fade-up">
    <div class="lg:col-span-3">
      <p class="text-caption uppercase tracking-[0.2em] text-accent-bronze-bright/80 mb-4">Overview</p>
      <p class="text-body-lg text-text-secondary leading-relaxed">
        {project.fullDescription}
      </p>
    </div>

    <aside class="lg:col-span-2">
      <div class="lg:sticky lg:top-32 space-y-6">
        <div class="surface-elevated p-6">
          <h2 class="text-caption uppercase tracking-[0.2em] text-accent-bronze-bright/80 mb-4">What we did</h2>
          <ul class="space-y-2.5">
            {project.services.map((service) => (
              <li class="flex items-center gap-3 text-text-secondary">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-bronze-bright/70 shrink-0"></span>
                {service}
              </li>
            ))}
          </ul>

          {liveUrl && (
            <>
              <div class="h-px bg-border-primary my-5"></div>
              <a
                href={`https://${liveUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="visit-link group/vl inline-flex items-center gap-2 text-caption font-medium text-white"
              >
                <span class="visit-label">Visit the live site</span>
                <span class="transition-transform duration-300 ease-out group-hover/vl:translate-x-0.5 group-hover/vl:-translate-y-0.5 text-metallic">↗</span>
              </a>
              <p class="text-caption text-text-muted mt-1">{liveUrl}</p>
            </>
          )}
        </div>

        <!-- Testimonial (only when real) -->
        {project.testimonial && (
          <div class="surface-elevated p-6 relative">
            <div class="absolute top-3 left-6 text-6xl text-border-secondary font-serif leading-none select-none" aria-hidden="true">
              &ldquo;
            </div>
            <blockquote class="relative pt-8">
              <p class="text-body-lg text-text-secondary italic mb-5">
                &ldquo;{project.testimonial.quote}&rdquo;
              </p>
              <footer>
                <p class="font-medium text-white">{project.testimonial.author}</p>
                <p class="text-caption text-text-muted">{project.testimonial.role}</p>
              </footer>
            </blockquote>
          </div>
        )}
      </div>
    </aside>
  </div>

  <!-- Selected screens gallery — real pages from the project, each captioned -->
  {gallery.length > 0 && (
    <div class="mt-16 md:mt-24" data-animate="fade-up">
      <div class="flex items-center gap-4 mb-8 md:mb-12">
        <h2 class="text-h3 text-white whitespace-nowrap">Selected screens</h2>
        <span class="h-px flex-1 bg-gradient-to-r from-border-secondary to-transparent"></span>
      </div>

      <!-- Website galleries stay a one-at-a-time carousel at every size (the wide
           screens fill the column, nicer than a stack). Phone galleries are a
           carousel on mobile but a row from sm up, so app screens don't sit alone
           in a sea of dead space on tablet/desktop. -->
      <figure class="group" data-carousel>
        <div
          class:list={[
            'carousel-rail no-scrollbar flex gap-0 overflow-x-auto snap-x snap-mandatory py-6',
            isPhoneGallery ? 'sm:flex-row sm:gap-6 sm:overflow-visible' : '',
          ]}
        >
          {gallery.map((s, i) => (
            <div
              class:list={[
                'carousel-slide snap-center shrink-0 w-full flex flex-col items-center',
                isPhoneGallery && 'sm:flex-1 sm:w-auto',
              ]}
            >
              <button
                type="button"
                class:list={[
                  'lightbox-trigger group/z relative block cursor-zoom-in',
                  s.type === 'phone' ? 'w-[248px] max-w-[74%] sm:w-full sm:max-w-none' : 'w-full max-w-[1040px]',
                ]}
                data-lightbox-trigger
                data-src={s.src}
                data-caption={s.label}
                data-kind={s.type ?? 'browser'}
                aria-label={`Expand ${s.label}`}
              >
                {s.type === 'phone' ? (
                  <img
                    src={s.src}
                    alt={`${project.title} — ${s.label}`}
                    width={447}
                    height={944}
                    loading="lazy"
                    decoding="async"
                    class="device-phone h-auto block w-full"
                  />
                ) : (
                  <ProjectFrame
                    variant="browser"
                    src={s.src}
                    alt={`${project.title} — ${s.label}`}
                    url={liveUrl}
                    sizes="(min-width: 1024px) 1040px, 100vw"
                  />
                )}
                <!-- Expand hint -->
                <span class="lb-hint" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                  </svg>
                </span>
              </button>
              {s.label && (
                <figcaption class="mt-3 flex items-center gap-2 text-caption text-text-muted justify-center">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent-bronze-bright/70 shrink-0"></span>
                  {s.label}
                </figcaption>
              )}
            </div>
          ))}
        </div>

        <!-- Carousel controls: dots always (in carousel mode) + arrows on sm+.
             Phone galleries are a row on sm+, so their controls hide there. -->
        {gallery.length > 1 && (
          <div class:list={['carousel-controls flex items-center justify-center gap-4 mt-5', isPhoneGallery && 'sm:hidden']}>
            <button type="button" class="carousel-arrow carousel-prev hidden sm:flex" aria-label="Previous screen">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18 9 12l6-6" /></svg>
            </button>
            <div class="carousel-dots flex justify-center gap-2">
              {gallery.map((_, i) => (
                <button type="button" class="carousel-dot" aria-label={`Go to screen ${i + 1}`}></button>
              ))}
            </div>
            <button type="button" class="carousel-arrow carousel-next hidden sm:flex" aria-label="Next screen">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
            </button>
          </div>
        )}
      </figure>
    </div>
  )}

  <!-- Lightbox overlay (one per page; populated on click) -->
  {gallery.length > 0 && (
    <div class="lightbox" data-lightbox aria-hidden="true" role="dialog" aria-modal="true" aria-label="Expanded screen view">
      <button type="button" class="lightbox-btn lightbox-close" aria-label="Close">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
      <button type="button" class="lightbox-btn lightbox-prev" aria-label="Previous screen">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18 9 12l6-6" /></svg>
      </button>
      <button type="button" class="lightbox-btn lightbox-next" aria-label="Next screen">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
      </button>
      <figure class="lightbox-stage">
        <img class="lightbox-img" alt="" decoding="async" />
        <figcaption class="lightbox-cap"></figcaption>
      </figure>
    </div>
  )}
</Section>

<style>
  /* Framed phone (transparent mockup): a tight per-phone soft shadow lifts it off
     the dark page without wide glows merging into a grey haze behind the row. */
  .device-phone {
    filter:
      drop-shadow(0 12px 24px rgba(0, 0, 0, 0.5))
      drop-shadow(0 0 6px rgba(255, 255, 255, 0.05));
  }

  /* Hide the scrollbar on the swipe rail (still scrollable/keyboard-accessible) */
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  .no-scrollbar::-webkit-scrollbar { display: none; }

  /* Carousel progress dots */
  .carousel-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-border-secondary);
    transition: width 0.35s var(--ease-out-expo), background-color 0.35s var(--ease-out-expo);
    cursor: pointer;
  }
  .carousel-dot.is-active {
    width: 22px;
    background: var(--color-accent-bronze-bright);
  }

  /* Carousel prev/next arrows (shown on sm+ for pointer navigation) */
  .carousel-arrow {
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: var(--color-text-secondary);
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border-primary);
    cursor: pointer;
    transition: color 0.25s var(--ease-out-expo), background-color 0.25s var(--ease-out-expo),
      border-color 0.25s var(--ease-out-expo), transform 0.25s var(--ease-out-expo);
  }
  .carousel-arrow:hover {
    color: #fff;
    background: var(--color-surface-raised);
    border-color: rgba(224, 162, 96, 0.5);
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-arrow { transition: none; }
  }

  /* Expand hint on each clickable screen */
  .lb-hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 9999px;
    color: #fff;
    background: rgba(9, 9, 11, 0.55);
    border: 1px solid var(--color-border-highlight);
    backdrop-filter: blur(6px);
    opacity: 0.7;
    transition: opacity 0.3s var(--ease-out-expo), transform 0.3s var(--ease-out-expo);
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .lb-hint { opacity: 0; transform: translateY(4px); }
    .lightbox-trigger:hover .lb-hint { opacity: 1; transform: translateY(0); }
  }
  :focus-visible > .lb-hint { opacity: 1; transform: none; }

  /* Lightbox overlay */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 5vw, 56px);
    background: rgba(6, 6, 8, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.32s var(--ease-out-soft), visibility 0.32s var(--ease-out-soft);
  }
  .lightbox.is-open { opacity: 1; visibility: visible; }
  .lightbox-stage {
    max-width: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .lightbox-img {
    max-width: min(94vw, 1280px);
    max-height: 82vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: var(--shadow-elevated-lg);
    background: var(--color-background-primary);
    transform: scale(0.98);
    transition: transform 0.32s var(--ease-out-expo);
  }
  .lightbox.is-open .lightbox-img { transform: scale(1); }
  .lightbox-img.is-phone {
    max-height: 84vh;
    max-width: min(88vw, 360px);
    border-radius: 0;
    background: none;
    box-shadow: none;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.55));
  }
  .lightbox-cap {
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    text-align: center;
  }
  .lightbox-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    color: #fff;
    background: rgba(32, 32, 36, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(6px);
    cursor: pointer;
    transition: background-color 0.25s var(--ease-out-expo), border-color 0.25s var(--ease-out-expo), transform 0.25s var(--ease-out-expo);
  }
  .lightbox-btn:hover {
    background: rgba(48, 48, 54, 0.92);
    border-color: rgba(224, 162, 96, 0.6);
  }
  .lightbox-close { top: clamp(14px, 3vw, 28px); right: clamp(14px, 3vw, 28px); }
  .lightbox-prev { left: clamp(10px, 2.5vw, 28px); top: 50%; transform: translateY(-50%); }
  .lightbox-next { right: clamp(10px, 2.5vw, 28px); top: 50%; transform: translateY(-50%); }
  .lightbox-prev:hover { transform: translateY(-50%) scale(1.06); }
  .lightbox-next:hover { transform: translateY(-50%) scale(1.06); }
  .lightbox[data-single] .lightbox-prev,
  .lightbox[data-single] .lightbox-next { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .lightbox, .lightbox-img, .lb-hint, .lightbox-btn { transition: none; }
    .lightbox-img { transform: none; }
  }

  .visit-label {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.4s var(--ease-out-expo);
    padding-bottom: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .visit-link:hover .visit-label { background-size: 100% 1px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .visit-label { transition: none; }
  }
</style>

<script>
  // Sync the mobile carousel's progress dots with the swipe position, and let a
  // dot click jump to that phone. Desktop shows the full row, so dots are hidden.
  function initPhoneCarousels() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      if (root.dataset.carouselReady) return;
      const rail = root.querySelector<HTMLElement>('.carousel-rail');
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.carousel-dot'));
      if (!rail || !dots.length) return;
      root.dataset.carouselReady = '1';

      let raf = 0;
      const sync = () => {
        const i = Math.round(rail.scrollLeft / rail.clientWidth);
        const active = Math.max(0, Math.min(dots.length - 1, i));
        dots.forEach((d, idx) => d.classList.toggle('is-active', idx === active));
      };
      rail.addEventListener(
        'scroll',
        () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(sync);
        },
        { passive: true }
      );
      dots.forEach((d, idx) =>
        d.addEventListener('click', () =>
          rail.scrollTo({ left: idx * rail.clientWidth, behavior: 'smooth' })
        )
      );
      root
        .querySelector<HTMLButtonElement>('.carousel-prev')
        ?.addEventListener('click', () => rail.scrollBy({ left: -rail.clientWidth, behavior: 'smooth' }));
      root
        .querySelector<HTMLButtonElement>('.carousel-next')
        ?.addEventListener('click', () => rail.scrollBy({ left: rail.clientWidth, behavior: 'smooth' }));
      sync();
    });
  }

  // Lightbox: click a Selected screen to see it enlarged; prev/next/Esc/arrows.
  function initLightbox() {
    const box = document.querySelector<HTMLElement>('[data-lightbox]');
    if (!box || box.dataset.ready) return;
    const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]'));
    if (!triggers.length) return;
    box.dataset.ready = '1';

    const img = box.querySelector<HTMLImageElement>('.lightbox-img')!;
    const cap = box.querySelector<HTMLElement>('.lightbox-cap')!;
    if (triggers.length < 2) box.setAttribute('data-single', '');
    let idx = 0;
    let lastFocused: HTMLElement | null = null;

    const render = () => {
      const t = triggers[idx];
      img.src = t.dataset.src || '';
      img.alt = t.dataset.caption || '';
      img.classList.toggle('is-phone', t.dataset.kind === 'phone');
      cap.textContent = t.dataset.caption || '';
    };
    const open = (i: number) => {
      idx = i;
      lastFocused = document.activeElement as HTMLElement;
      render();
      box.classList.add('is-open');
      box.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      box.querySelector<HTMLElement>('.lightbox-close')?.focus();
    };
    const close = () => {
      box.classList.remove('is-open');
      box.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lastFocused?.focus();
    };
    const go = (d: number) => {
      idx = (idx + d + triggers.length) % triggers.length;
      render();
    };

    triggers.forEach((t, i) =>
      t.addEventListener('click', (e) => {
        e.preventDefault();
        open(i);
      })
    );
    box.querySelector('.lightbox-close')?.addEventListener('click', close);
    box.querySelector('.lightbox-prev')?.addEventListener('click', () => go(-1));
    box.querySelector('.lightbox-next')?.addEventListener('click', () => go(1));
    box.addEventListener('click', (e) => {
      if (e.target === box) close();
    });
    document.addEventListener('keydown', (e) => {
      if (!box.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'ArrowRight') go(1);
    });
  }

  initPhoneCarousels();
  initLightbox();
  document.addEventListener('astro:page-load', () => {
    initPhoneCarousels();
    initLightbox();
  });
</script>
