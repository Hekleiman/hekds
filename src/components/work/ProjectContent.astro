---
import Section from '../ui/Section.astro';
import ProjectFrame from '../ui/ProjectFrame.astro';
import type { Project } from '../../data/projects';
import { portfolioImageFor, type GalleryShot } from '../../lib/portfolioImages';

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className } = Astro.props;

const mapped = portfolioImageFor({ slug: project.slug, title: project.title });
const primarySrc = mapped?.src ?? project.thumbnail;

// Prefer Sanity images when populated; otherwise fall back to the mapped gallery.
const gallery: GalleryShot[] =
  project.images && project.images.length > 0
    ? project.images.map((src, i) => ({ src, label: `Screen ${i + 1}`, type: 'browser' as const }))
    : mapped?.gallery ?? [];

// A gallery is a "device" gallery when every slide is a phone — it becomes a row
// on desktop; browser galleries stack. Both are a one-at-a-time carousel on mobile.
const isPhoneGallery = gallery.length > 0 && gallery.every((g) => g.type === 'phone');

const liveUrl = mapped?.url;
---

<Section class:list={['pt-0!', className]}>
  <!-- Primary framed shot — the "money shot", in browser chrome -->
  {primarySrc && (
    <div class="relative mb-16 md:mb-24 group" data-animate="fade-up">
      <div class="aura w-[70%] h-[60%] top-[10%] left-1/2 -translate-x-1/2 bg-accent-bronze/[0.07]"></div>
      <div class="relative max-w-[980px] mx-auto">
        <ProjectFrame
          variant={mapped?.variant ?? 'browser'}
          src={primarySrc}
          alt={`${project.title} — ${project.category}, built by HEK Design Studio`}
          url={mapped?.url}
          width={1600}
          height={1000}
          loading="eager"
          sizes="(min-width: 1024px) 980px, 100vw"
        />
      </div>
    </div>
  )}

  <!-- Overview: lead paragraph + a meta card (services, live link) -->
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16" data-animate="fade-up">
    <div class="lg:col-span-3">
      <p class="text-caption uppercase tracking-[0.2em] text-accent-bronze-bright/80 mb-4">Overview</p>
      <p class="text-body-lg text-text-secondary leading-relaxed">
        {project.fullDescription}
      </p>
    </div>

    <aside class="lg:col-span-2">
      <div class="lg:sticky lg:top-32 space-y-6">
        <div class="surface-elevated p-6">
          <h2 class="text-caption uppercase tracking-[0.18em] text-accent-bronze-bright/80 mb-4">What we did</h2>
          <ul class="space-y-2.5">
            {project.services.map((service) => (
              <li class="flex items-center gap-3 text-text-secondary">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-bronze-bright/70 shrink-0"></span>
                {service}
              </li>
            ))}
          </ul>

          {liveUrl && (
            <>
              <div class="h-px bg-border-primary my-5"></div>
              <a
                href={`https://${liveUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="visit-link group/vl inline-flex items-center gap-2 text-caption font-medium text-white"
              >
                <span class="visit-label">Visit the live site</span>
                <span class="transition-transform duration-300 ease-out group-hover/vl:translate-x-0.5 group-hover/vl:-translate-y-0.5 text-metallic">↗</span>
              </a>
              <p class="text-caption text-text-muted mt-1">{liveUrl}</p>
            </>
          )}
        </div>

        <!-- Testimonial (only when real) -->
        {project.testimonial && (
          <div class="surface-elevated p-6 relative">
            <div class="absolute top-3 left-6 text-6xl text-border-secondary font-serif leading-none select-none" aria-hidden="true">
              &ldquo;
            </div>
            <blockquote class="relative pt-8">
              <p class="text-body-lg text-text-secondary italic mb-5">
                &ldquo;{project.testimonial.quote}&rdquo;
              </p>
              <footer>
                <p class="font-medium text-white">{project.testimonial.author}</p>
                <p class="text-caption text-text-muted">{project.testimonial.role}</p>
              </footer>
            </blockquote>
          </div>
        )}
      </div>
    </aside>
  </div>

  <!-- Selected screens gallery — real pages from the project, each captioned -->
  {gallery.length > 0 && (
    <div class="mt-16 md:mt-28" data-animate="fade-up">
      <div class="flex items-center gap-4 mb-8 md:mb-12">
        <h2 class="text-h3 text-white whitespace-nowrap">Selected screens</h2>
        <span class="h-px flex-1 bg-border-primary"></span>
      </div>

      <!-- One-at-a-time swipe carousel with progress dots on mobile; on desktop a
           phone gallery becomes a row and a browser gallery stacks. -->
      <figure class="group" data-carousel>
        <div
          class:list={[
            'carousel-rail no-scrollbar flex gap-0 overflow-x-auto snap-x snap-mandatory py-6',
            isPhoneGallery
              ? 'lg:flex-row lg:gap-6 lg:overflow-visible'
              : 'lg:flex-col lg:items-center lg:gap-14 lg:overflow-visible lg:py-0 lg:mt-0',
          ]}
        >
          {gallery.map((s, i) => (
            <div
              class:list={[
                'carousel-slide snap-center shrink-0 w-full flex flex-col',
                isPhoneGallery ? 'items-center lg:flex-1 lg:w-auto' : 'lg:w-full lg:max-w-[940px]',
              ]}
            >
              {s.type === 'phone' ? (
                <img
                  src={s.src}
                  alt={`${project.title} — ${s.label}`}
                  loading="lazy"
                  decoding="async"
                  class="device-phone h-auto block w-[248px] max-w-[74%] lg:w-full lg:max-w-none"
                />
              ) : (
                <ProjectFrame
                  variant="browser"
                  src={s.src}
                  alt={`${project.title} — ${s.label}`}
                  url={liveUrl}
                  sizes="(min-width: 1024px) 940px, 100vw"
                />
              )}
              {s.label && (
                <figcaption class="mt-3 flex items-center gap-2 text-caption text-text-muted justify-center lg:justify-start">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent-bronze-bright/70 shrink-0"></span>
                  {s.label}
                </figcaption>
              )}
            </div>
          ))}
        </div>

        <!-- Progress dots (mobile only; hidden when there's a single slide) -->
        {gallery.length > 1 && (
          <div class="carousel-dots flex justify-center gap-2 mt-4 lg:hidden">
            {gallery.map((_, i) => (
              <button type="button" class="carousel-dot" aria-label={`Go to screen ${i + 1}`}></button>
            ))}
          </div>
        )}
      </figure>
    </div>
  )}
</Section>

<style>
  /* Framed phone (transparent mockup): a tight per-phone soft shadow lifts it off
     the dark page without wide glows merging into a grey haze behind the row. */
  .device-phone {
    filter:
      drop-shadow(0 12px 24px rgba(0, 0, 0, 0.5))
      drop-shadow(0 0 6px rgba(255, 255, 255, 0.05));
  }

  /* Hide the scrollbar on the swipe rail (still scrollable/keyboard-accessible) */
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  .no-scrollbar::-webkit-scrollbar { display: none; }

  /* Carousel progress dots */
  .carousel-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-border-secondary);
    transition: width 0.35s var(--ease-out-expo), background-color 0.35s var(--ease-out-expo);
    cursor: pointer;
  }
  .carousel-dot.is-active {
    width: 22px;
    background: var(--color-accent-bronze-bright);
  }

  .visit-label {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.4s var(--ease-out-expo);
    padding-bottom: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .visit-link:hover .visit-label { background-size: 100% 1px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .visit-label { transition: none; }
  }
</style>

<script>
  // Sync the mobile carousel's progress dots with the swipe position, and let a
  // dot click jump to that phone. Desktop shows the full row, so dots are hidden.
  function initPhoneCarousels() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      if (root.dataset.carouselReady) return;
      const rail = root.querySelector<HTMLElement>('.carousel-rail');
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.carousel-dot'));
      if (!rail || !dots.length) return;
      root.dataset.carouselReady = '1';

      let raf = 0;
      const sync = () => {
        const i = Math.round(rail.scrollLeft / rail.clientWidth);
        const active = Math.max(0, Math.min(dots.length - 1, i));
        dots.forEach((d, idx) => d.classList.toggle('is-active', idx === active));
      };
      rail.addEventListener(
        'scroll',
        () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(sync);
        },
        { passive: true }
      );
      dots.forEach((d, idx) =>
        d.addEventListener('click', () =>
          rail.scrollTo({ left: idx * rail.clientWidth, behavior: 'smooth' })
        )
      );
      sync();
    });
  }

  initPhoneCarousels();
  document.addEventListener('astro:page-load', initPhoneCarousels);
</script>
