---
import Section from '../ui/Section.astro';

interface Props {
  title: string;
  category: string;
  year: string;
  client?: string;
  class?: string;
}

const { title, category, year, client, class: className } = Astro.props;
---

<section class:list={['relative overflow-hidden', className]} data-spotlight>
  <!-- Depth glow -->
  <div class="aura w-[560px] h-[360px] top-[-4%] left-1/2 -translate-x-1/2 bg-accent-bronze/[0.09]"></div>

  <!-- Blueprint contour layer -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.4]" aria-hidden="true" data-parallax data-parallax-speed="-0.08">
    <svg class="w-full h-full" viewBox="0 0 1440 520" fill="none" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <path d="M-40 200 C 260 150, 460 260, 720 200 S 1140 110, 1500 190" stroke="var(--color-border-secondary)" stroke-width="1" data-draw="hero" />
      <path d="M-40 280 C 300 220, 500 340, 780 270 S 1180 170, 1500 250" stroke="var(--color-border-primary)" stroke-width="1" data-draw="hero" />
    </svg>
  </div>

  <!-- Cursor spotlight -->
  <div
    class="absolute w-[520px] h-[520px] rounded-full opacity-0 pointer-events-none mix-blend-screen -ml-[260px] -mt-[260px]"
    style="background: radial-gradient(circle, rgba(224,162,96,0.12) 0%, rgba(224,162,96,0.05) 35%, transparent 70%);"
    aria-hidden="true"
    data-spotlight-light
  >
  </div>

  <Section class="pt-8 pb-14 relative z-10" data-animate="fade-up">
    <!-- Back Link -->
    <a
      href="/work"
      class="inline-flex items-center gap-2 text-caption text-text-muted hover:text-white transition-colors duration-150 mb-8"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      Back to Work
    </a>

    <!-- Category eyebrow (metallic role, echoing the index) -->
    <p class="text-caption uppercase tracking-[0.18em] text-accent-bronze-bright/85 mb-4">
      {category} <span class="text-text-muted">· {year}</span>
    </p>

    <!-- Title -->
    <h1 class="text-h1 text-white mb-4 max-w-[16ch]">{title}</h1>

    <!-- Meta (only when the client name adds information beyond the title) -->
    {client && client.trim().toLowerCase() !== title.trim().toLowerCase() && (
      <p class="text-body-lg text-text-secondary">
        {client}
      </p>
    )}
  </Section>
</section>
