---
// Work hero — a sibling of the Home hero (Hero.astro): same layered vocabulary
// (aura glow, parallax blueprint contours, cursor spotlight, clip-reveal headline
// with a metallic focal line, and the xl: single-line re-fit), sized as a page
// header rather than a full-viewport hero.
interface Props {
  eyebrow?: string;
  eyebrowShort?: string;
  headlineLine1?: string;
  headlineLine2?: string;
  subtext?: string;
  meta?: string;
  class?: string;
}

const {
  eyebrow = 'Portfolio — selected projects',
  eyebrowShort = 'Selected projects',
  headlineLine1 = 'Sites and apps,',
  headlineLine2 = 'crafted end-to-end.',
  subtext = 'A selection of projects we designed and built ourselves — no handoffs, every detail considered, from first wireframe to launch.',
  meta = 'Web & app design + development',
  class: className,
} = Astro.props;
---

<section
  class:list={['work-hero relative overflow-hidden', className]}
  data-animate="hero"
  data-spotlight
>
  <!-- Depth glow -->
  <div class="aura w-[620px] h-[440px] top-[-6%] left-1/2 -translate-x-1/2 bg-accent-bronze/[0.10]"></div>

  <!-- Living-blueprint contour layer (parallax + draw-in on load) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.45]"
    aria-hidden="true"
    data-parallax
    data-parallax-speed="-0.1"
  >
    <svg class="w-full h-full" viewBox="0 0 1440 640" fill="none" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <path d="M-40 220 C 260 160, 460 280, 720 220 S 1140 120, 1500 200" stroke="var(--color-border-secondary)" stroke-width="1" data-draw="hero" />
      <path d="M-40 300 C 300 240, 500 360, 780 290 S 1180 180, 1500 270" stroke="var(--color-border-primary)" stroke-width="1" data-draw="hero" />
      <path d="M-40 150 C 240 110, 520 200, 760 150 S 1120 60, 1500 130" stroke="var(--color-border-primary)" stroke-width="1" data-draw="hero" />
    </svg>
  </div>

  <!-- Cursor spotlight -->
  <div
    class="absolute w-[600px] h-[600px] rounded-full opacity-0 pointer-events-none mix-blend-screen -ml-[300px] -mt-[300px]"
    style="background: radial-gradient(circle, rgba(224,162,96,0.12) 0%, rgba(224,162,96,0.05) 35%, transparent 70%);"
    aria-hidden="true"
    data-spotlight-light
  >
  </div>

  <!-- Content -->
  <div class="relative z-10 container-main pt-10 pb-6 sm:pt-16 flex flex-col items-center text-center">
    <!-- Eyebrow pill -->
    <div
      class="inline-flex items-center gap-2 mb-8 px-4 py-1.5 rounded-full border border-border-primary bg-background-secondary/60 backdrop-blur-sm"
      data-hero="eyebrow"
    >
      <span class="w-1.5 h-1.5 shrink-0 rounded-full bg-accent-bronze-bright"></span>
      <span class="text-caption text-text-secondary tracking-wide whitespace-nowrap">
        <span class="sm:hidden">{eyebrowShort}</span>
        <span class="hidden sm:inline">{eyebrow}</span>
      </span>
    </div>

    <!-- Clip-reveal headline; second line metallic. Collapses to one line on xl. -->
    <h1 class="work-headline mb-7" data-hero="headline">
      <span class="line"><span class="line-inner text-white">{headlineLine1}</span></span><span class="line"><span class="line-inner text-metallic metallic-shimmer">{headlineLine2}</span></span>
    </h1>

    <!-- Subtext -->
    <p class="text-body-lg text-text-secondary max-w-[600px] mb-7" data-hero="subtext">
      {subtext}
    </p>

    <!-- Meta row -->
    <p class="text-caption uppercase tracking-[0.2em] text-text-muted" data-hero="cta">
      {meta}
    </p>
  </div>
</section>

<style>
  .work-headline {
    font-weight: 600;
    font-size: clamp(2rem, 1.0rem + 4.2vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .work-headline .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .work-headline .line-inner {
    display: block;
  }

  /* Wide desktop: single line, capped so the full string fits the content column. */
  @media (min-width: 1280px) {
    .work-headline {
      font-size: clamp(2.75rem, 1.6rem + 1.9vw, 3.5rem);
      white-space: nowrap;
    }
    .work-headline .line {
      display: inline-block;
      vertical-align: top;
      padding-bottom: 0.12em;
    }
    .work-headline .line + .line {
      margin-left: 0.28em;
    }
  }
</style>
