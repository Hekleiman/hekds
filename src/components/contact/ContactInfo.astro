---
// Contact info rail — rebuilt on the elevated-card + blueprint language. The
// email is the hero (big, metallic, click-to-copy). Each card carries a bespoke
// programmatic SVG mark (same family as ServiceIllustration / TierMedallion), and
// a two-person card makes the honest "no handoffs" positioning explicit.
interface SocialLinks {
  linkedin?: string;
  instagram?: string;
  tiktok?: string;
}

interface Props {
  email?: string;
  emailLabel?: string;
  responseTime?: string;
  responseTimeLabel?: string;
  location?: string;
  locationLabel?: string;
  socialLabel?: string;
  socialLinks?: SocialLinks;
  class?: string;
}

const {
  email = 'harry@hekdesigns.com',
  emailLabel = 'Email us directly',
  responseTime = 'Within 24 hours',
  responseTimeLabel = 'Response time',
  location = 'Remote / Worldwide',
  locationLabel = 'Based in',
  socialLabel = 'Follow along',
  socialLinks,
  class: className,
} = Astro.props;

// The studio is two people, so "Follow us" links straight to Harrison and Erik
// on LinkedIn rather than a generic company handle. (Sanity's socialLinks schema
// models one handle per platform, so these two founder profiles live here.)
const displaySocials = [
  { name: 'Harrison', url: 'https://www.linkedin.com/in/harrison-kipper/' },
  { name: 'Erik', url: 'https://www.linkedin.com/in/henry-erik-kleiman-85aa99288/' },
  { name: 'HEK Designs', url: 'https://www.linkedin.com/company/hekdesigns' },
];
---

<div class:list={['flex flex-col gap-5', className]} data-animate="stagger">
  <!-- Email + Follow us — the two "reach us" cards, paired side by side where
       there's room (2-up at md; stacked on mobile and the narrow lg rail). -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 gap-5">
    <!-- Email — metallic, copyable, with a crafted confirmation. -->
    <div class="surface-elevated lift p-6">
      <div class="flex items-start gap-4">
        <!-- Envelope mark (blueprint + one bronze send-node) -->
        <div class="info-mark shrink-0" aria-hidden="true">
          <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="0.75" y="0.75" width="54.5" height="54.5" rx="13" class="mk-frame" />
            <rect x="14" y="18" width="28" height="20" rx="3" class="mk-line" />
            <path d="M14.5 20 L28 30 L41.5 20" class="mk-line" />
            <circle cx="41.5" cy="20" r="2.6" class="mk-accent-fill" />
            <path d="M14 34 L21 28 M42 34 L35 28" class="mk-line faint" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <span class="text-caption text-text-muted">{emailLabel}</span>
          <div class="mt-1.5 flex items-center gap-2">
            <a
              href={`mailto:${email}`}
              class="email-address text-metallic-bronze font-semibold tracking-tight min-w-0"
            >
              {email}
            </a>
            <button
              type="button"
              class="copy-email inline-flex items-center justify-center shrink-0 ml-auto w-8 h-8 rounded-full border border-border-secondary text-text-secondary hover:text-white hover:border-accent-bronze-bright/60 transition-colors duration-200"
              data-email={email}
              aria-label={`Copy email address ${email}`}
              title="Copy email address"
            >
              <svg class="copy-icon copy-icon--copy" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <rect x="4.5" y="4.5" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.3" />
                <path d="M9.5 4.5V3a1.5 1.5 0 0 0-1.5-1.5H3A1.5 1.5 0 0 0 1.5 3v5A1.5 1.5 0 0 0 3 9.5h1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
              </svg>
              <svg class="copy-icon copy-icon--done" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M2.5 7.5 L5.75 10.75 L11.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Follow us — the studio's two founders + the company, on LinkedIn. -->
    <div class="surface-elevated lift p-6">
      <div class="flex items-start gap-4">
        <div class="info-mark shrink-0" aria-hidden="true">
          <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="0.75" y="0.75" width="54.5" height="54.5" rx="13" class="mk-frame" />
            <line x1="22" y1="24" x2="34" y2="19" class="mk-line faint" />
            <line x1="22" y1="32" x2="34" y2="37" class="mk-line faint" />
            <circle cx="20" cy="28" r="4" class="mk-accent-stroke" />
            <circle cx="37" cy="18" r="3.4" class="mk-line" />
            <circle cx="37" cy="38" r="3.4" class="mk-line" />
            <circle cx="20" cy="28" r="1.6" class="mk-accent-fill" />
          </svg>
        </div>
        <div class="flex flex-col gap-1.5">
          <span class="text-caption text-text-muted">{socialLabel}</span>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            {displaySocials.map((link, index) => (
              <>
                <a
                  href={link.url}
                  class="text-body text-text-secondary hover:text-white transition-colors duration-200"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.name}
                </a>
                {index < displaySocials.length - 1 && (
                  <span class="text-text-muted" aria-hidden="true">·</span>
                )}
              </>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Response time + Based in — 2-up at md (info sits full-width there), 1-up
       otherwise (mobile stack + narrow lg rail). -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 gap-5">
    <!-- Response time -->
    <div class="surface-elevated lift p-6">
      <div class="flex items-start gap-4">
        <div class="info-mark shrink-0" aria-hidden="true">
          <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="0.75" y="0.75" width="54.5" height="54.5" rx="13" class="mk-frame" />
            <circle cx="28" cy="28" r="13" class="mk-line" />
            <path d="M28 15.5V13 M28 43v-2.5 M15.5 28H13 M43 28h-2.5" class="mk-line faint" />
            <path d="M28 28 V20" class="mk-line" />
            <path d="M28 28 L34 31.5" class="mk-accent-stroke" />
            <circle cx="28" cy="28" r="1.8" class="mk-accent-fill" />
          </svg>
        </div>
        <div class="flex flex-col gap-1">
          <span class="text-caption text-text-muted">{responseTimeLabel}</span>
          <span class="text-body text-text-primary font-medium">{responseTime}</span>
        </div>
      </div>
    </div>

    <!-- Based in -->
    <div class="surface-elevated lift p-6">
      <div class="flex items-start gap-4">
        <div class="info-mark shrink-0" aria-hidden="true">
          <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="0.75" y="0.75" width="54.5" height="54.5" rx="13" class="mk-frame" />
            <circle cx="28" cy="28" r="13" class="mk-line" />
            <path d="M15 28h26" class="mk-line faint" />
            <ellipse cx="28" cy="28" rx="6" ry="13" class="mk-line faint" />
            <circle cx="33" cy="22.5" r="2.6" class="mk-accent-fill" />
          </svg>
        </div>
        <div class="flex flex-col gap-1">
          <span class="text-caption text-text-muted">{locationLabel}</span>
          <span class="text-body text-text-primary font-medium">{location}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Two-person nod — the honest, differentiating fact plotted as two joined
       blueprint nodes (H · E). -->
  <div class="surface-elevated lift p-6 sm:p-7">
    <div class="flex items-start gap-4">
      <div class="info-mark shrink-0" aria-hidden="true">
        <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="0.75" y="0.75" width="54.5" height="54.5" rx="13" class="mk-frame" />
          <line x1="19" y1="28" x2="37" y2="28" class="mk-line" />
          <circle cx="19" cy="28" r="6" class="mk-line" />
          <circle cx="37" cy="28" r="6" class="mk-accent-stroke" />
          <path d="M19 28 v9 M37 28 v9" class="mk-line faint" />
          <circle cx="19" cy="28" r="1.8" class="mk-dot" />
          <circle cx="37" cy="28" r="1.8" class="mk-accent-fill" />
        </svg>
      </div>
      <div class="flex flex-col gap-1.5">
        <span class="text-caption text-text-muted">Who you're talking to</span>
        <span class="text-body text-text-primary font-medium">Harrison &amp; Erik — the whole studio</span>
        <p class="text-caption text-text-secondary leading-relaxed">
          No handoffs, no account managers. The person who reads your message is the person who designs and builds your site.
        </p>
      </div>
    </div>
  </div>

  <!-- Copy confirmation announcement (SR + visual is handled inline on the button) -->
  <span id="copy-live" class="sr-only" role="status" aria-live="polite"></span>
</div>

<style>
  .info-mark {
    width: 3rem;
    height: 3rem;
  }
  .info-mark svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Blueprint mark vocabulary (mirrors ServiceIllustration): faint frame + lines,
     one bronze focal accent per mark. */
  .mk-frame {
    fill: rgba(255, 255, 255, 0.02);
    stroke: var(--color-border-secondary);
    stroke-width: 1;
  }
  .mk-line {
    stroke: rgba(255, 255, 255, 0.28);
    stroke-width: 1.5;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mk-line.faint {
    stroke: rgba(255, 255, 255, 0.12);
  }
  .mk-dot {
    fill: rgba(255, 255, 255, 0.4);
  }
  .mk-accent-fill {
    fill: var(--color-accent-bronze-bright);
  }
  .mk-accent-stroke {
    stroke: var(--color-accent-bronze-bright);
    stroke-width: 1.75;
    fill: none;
    stroke-linecap: round;
  }

  /* Sized to fit on one line alongside the copy button, even for a long address
     on the narrowest phones; scales up on wider cards. */
  .email-address {
    font-size: clamp(0.875rem, 0.72rem + 0.62vw, 1.2rem);
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Icon-only copy button: show the clipboard by default, swap to a check on
     confirmation (JS toggles .is-copied; the label is announced via #copy-live). */
  .copy-email .copy-icon--done {
    display: none;
  }
  .copy-email.is-copied {
    color: var(--color-accent-bronze-bright);
    border-color: rgba(224, 162, 96, 0.6);
  }
  .copy-email.is-copied .copy-icon--copy {
    display: none;
  }
  .copy-email.is-copied .copy-icon--done {
    display: inline;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  function initCopyEmail() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.copy-email');
    const live = document.getElementById('copy-live');

    buttons.forEach((btn) => {
      // Guard against double-binding across View Transitions.
      if (btn.dataset.copyBound === 'true') return;
      btn.dataset.copyBound = 'true';

      const label = btn.querySelector('.copy-text');
      const email = btn.dataset.email || '';

      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(email);
        } catch {
          // Fallback: select via a temporary element
          const tmp = document.createElement('textarea');
          tmp.value = email;
          tmp.setAttribute('readonly', '');
          tmp.style.position = 'absolute';
          tmp.style.left = '-9999px';
          document.body.appendChild(tmp);
          tmp.select();
          try { document.execCommand('copy'); } catch { /* no-op */ }
          document.body.removeChild(tmp);
        }

        btn.classList.add('is-copied');
        if (label) label.textContent = 'Copied';
        if (live) live.textContent = `Email address ${email} copied to clipboard`;

        window.setTimeout(() => {
          btn.classList.remove('is-copied');
          if (label) label.textContent = 'Copy';
        }, 2000);
      });
    });
  }

  initCopyEmail();
  document.addEventListener('astro:page-load', initCopyEmail);
</script>
