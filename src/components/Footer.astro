---
interface Props {
  siteName?: string;
  tagline?: string;
  contactEmail?: string;
  copyright?: string;
  socialLinks?: {
    email?: string;
    linkedin?: string;
    instagram?: string;
    tiktok?: string;
  };
  class?: string;
}

const {
  siteName = 'HEK Design Studio',
  tagline = 'Design and development for modern web.',
  contactEmail = 'hello@hekdesign.studio',
  copyright = '© 2026 HEK Design Studio. All rights reserved.',
  socialLinks,
  class: className,
} = Astro.props;

const pageLinks = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
];

const contactLinks = [
  { href: '/pricing', label: 'Pricing' },
  { href: '/contact', label: 'Get in Touch' },
];

const connectLinks = [
  { href: `mailto:${socialLinks?.email || contactEmail}`, label: 'Email' },
  { href: socialLinks?.instagram || 'https://www.instagram.com/hekdesignstudio', label: 'Instagram', external: true },
  { href: socialLinks?.linkedin || 'https://www.linkedin.com/company/hekdesigns', label: 'LinkedIn', external: true },
  { href: socialLinks?.tiktok || 'https://www.tiktok.com/@hekdesignstudio', label: 'TikTok', external: true },
];
---

<footer class:list={['bg-background-primary border-t border-border-primary', className]}>
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-[100px] py-10 lg:py-16">
    <!-- Main Grid: 4 columns on desktop; on mobile/tablet the brand sits full
         width with the three link groups side by side (keeps the footer short). -->
    <div class="grid grid-cols-3 gap-x-5 gap-y-8 lg:grid-cols-4 lg:gap-8">
      <!-- Brand -->
      <div class="space-y-3 col-span-3 lg:col-span-1">
        <p class="text-lg font-bold text-white">
          {siteName}
        </p>
        <p class="text-zinc-400">
          {tagline}
        </p>
      </div>

      <!-- Pages -->
      <div>
        <h3 class="text-sm text-zinc-400 uppercase tracking-wider mb-3">
          Pages
        </h3>
        <ul>
          {pageLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-block py-1.5 text-zinc-400 hover:text-white transition-colors duration-150"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-sm text-zinc-400 uppercase tracking-wider mb-3">
          Contact
        </h3>
        <ul>
          {contactLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-block py-1.5 text-zinc-400 hover:text-white transition-colors duration-150"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h3 class="text-sm text-zinc-400 uppercase tracking-wider mb-3">
          Connect
        </h3>
        <ul>
          {connectLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-block py-1.5 text-zinc-400 hover:text-white transition-colors duration-150"
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-10 lg:mt-12 pt-6 border-t border-zinc-800">
      <div class="flex flex-col sm:flex-row sm:justify-between gap-4 text-sm text-zinc-400 text-center sm:text-left">
        <p>{copyright}</p>
        <div class="flex justify-center sm:justify-start gap-1">
          <a href="/privacy" class="py-1 hover:text-white transition-colors duration-150">Privacy</a>
          <span class="py-1">&middot;</span>
          <a href="/terms" class="py-1 hover:text-white transition-colors duration-150">Terms</a>
        </div>
      </div>
    </div>
  </div>
</footer>
