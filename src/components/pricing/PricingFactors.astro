---
import Section from '../ui/Section.astro';

interface Factor {
  title: string;
  description: string;
}

interface Props {
  headline?: string;
  eyebrow?: string;
  intro?: string;
  factors: Factor[];
  class?: string;
}

const {
  headline = 'What moves the number',
  eyebrow = 'Why it varies',
  intro = "We don't do fixed packages because no two projects are the same. Four things move the estimate — the more of each a project needs, the more it takes to build. We're upfront about which ones apply to yours before you commit.",
  factors,
  class: className,
} = Astro.props;

// Bespoke blueprint micro-illustration per factor, mapped by position (titles are
// CMS-editable, so we key off order, not text). Same living-blueprint language as
// ServiceIllustration.astro: faint grid, exact coordinates, one bronze focal.
const icons = ['scope', 'complexity', 'technical', 'timeline'] as const;
const items = factors.map((factor, index) => ({
  ...factor,
  number: String(index + 1).padStart(2, '0'),
  icon: icons[index % icons.length],
}));

// Metallic focal on the final word of the headline.
const headingText = (headline ?? '').trim() || 'What moves the number';
const hm = headingText.match(/^([\s\S]*\S)\s+(\S+?)([.!?…]*)$/);
const headLead = hm ? hm[1] : '';
const headAccent = hm ? hm[2] : headingText;
const headPunct = hm ? hm[3] : '';
---

<Section class:list={[className]}>
  <!-- Header -->
  <div class="mb-14 max-w-[680px]" data-animate="fade-up">
    <span class="text-caption uppercase tracking-[0.2em] text-accent-bronze-bright/80">{eyebrow}</span>
    <h2 class="text-h2 mt-3 mb-4">
      {headLead && <>{headLead}{' '}</>}<span class="text-metallic-bronze">{headAccent}</span>{headPunct}
    </h2>
    <p class="text-body-lg text-text-secondary">{intro}</p>
  </div>

  <!-- Factor cards: 1 → md:2 (clean 2×2) → lg:4. Elevated + lift, each carrying a
       bespoke blueprint micro-illustration. -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" data-animate="stagger">
    {items.map((factor) => (
      <div class="factor-card group surface-elevated lift p-6 flex flex-col">
        <div class="flex items-center justify-between mb-5">
          <span class="text-metallic text-[28px] leading-none font-semibold tabular-nums">{factor.number}</span>
          <div class="w-[104px] h-[62px] shrink-0 transition-transform duration-500 ease-out group-hover:scale-[1.03]">
            <svg viewBox="0 0 120 72" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full" aria-hidden="true">
              <defs>
                <pattern id={`fgrid-${factor.icon}`} width="12" height="12" patternUnits="userSpaceOnUse">
                  <path d="M12 0H0V12" fill="none" stroke="rgba(255,255,255,0.045)" stroke-width="1" />
                </pattern>
              </defs>
              <rect x="0" y="0" width="120" height="72" fill={`url(#fgrid-${factor.icon})`} />

              {factor.icon === 'scope' && (
                <g>
                  {/* nested frames growing outward; bronze corner handle = scope expanding */}
                  <rect x="30" y="24" width="30" height="24" rx="3" class="fl" />
                  <rect x="22" y="16" width="52" height="40" rx="4" class="fl-2" />
                  <rect x="14" y="10" width="76" height="52" rx="5" class="accent-stroke" />
                  <circle cx="90" cy="10" r="4" class="accent-fill" />
                  <path d="M90 10 h12 M90 10 v-6" class="accent-ln" />
                </g>
              )}

              {factor.icon === 'complexity' && (
                <g>
                  {/* layered nodes + connectors, one bronze focal (more parts = more work) */}
                  <line x1="30" y1="24" x2="60" y2="14" class="ln" />
                  <line x1="30" y1="24" x2="58" y2="46" class="ln" />
                  <line x1="60" y1="14" x2="92" y2="30" class="ln" />
                  <line x1="58" y1="46" x2="92" y2="30" class="accent-ln" />
                  <circle cx="30" cy="24" r="6" class="fl-2 ln" />
                  <circle cx="60" cy="14" r="6" class="fl-2 ln" />
                  <circle cx="58" cy="46" r="6" class="fl-2 ln" />
                  <circle cx="92" cy="30" r="7" class="accent-fill" />
                </g>
              )}

              {factor.icon === 'technical' && (
                <g>
                  {/* code brackets + a connected node (integrations / custom build) */}
                  <path d="M40 20 L24 36 L40 52" class="ln thick" />
                  <path d="M80 20 L96 36 L80 52" class="accent-ln thick" />
                  <line x1="66" y1="18" x2="54" y2="54" class="ln" />
                  <circle cx="96" cy="36" r="4" class="accent-fill" />
                </g>
              )}

              {factor.icon === 'timeline' && (
                <g>
                  {/* a track with ticks + a bronze marker (echoes ProcessTimeline) */}
                  <line x1="16" y1="36" x2="104" y2="36" class="ln" />
                  <line x1="16" y1="30" x2="16" y2="42" class="ln" />
                  <line x1="45" y1="31" x2="45" y2="41" class="ln faint" />
                  <line x1="74" y1="31" x2="74" y2="41" class="ln faint" />
                  <line x1="104" y1="30" x2="104" y2="42" class="ln" />
                  <line x1="16" y1="36" x2="74" y2="36" class="accent-ln thick" />
                  <circle cx="74" cy="36" r="6" class="accent-fill" />
                  <circle cx="74" cy="36" r="2.5" class="knob" />
                </g>
              )}
            </svg>
          </div>
        </div>

        <h3 class="text-h3 font-medium text-white mb-2">{factor.title}</h3>
        <p class="text-body text-text-secondary">{factor.description}</p>
      </div>
    ))}
  </div>
</Section>

<style>
  .factor-card .ln { stroke: rgba(255, 255, 255, 0.16); stroke-width: 1.5; fill: none; }
  .factor-card .ln.faint { stroke: rgba(255, 255, 255, 0.08); }
  .factor-card .ln.thick { stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .factor-card .fl { fill: rgba(255, 255, 255, 0.04); stroke: rgba(255, 255, 255, 0.16); stroke-width: 1.5; }
  .factor-card .fl-2 { fill: rgba(255, 255, 255, 0.06); }
  .factor-card .accent-fill { fill: var(--color-accent-bronze-bright); }
  .factor-card .accent-stroke { stroke: var(--color-accent-bronze-bright); stroke-width: 1.5; fill: rgba(224, 162, 96, 0.05); }
  .factor-card .accent-ln { stroke: var(--color-accent-bronze-bright); stroke-width: 2; fill: none; }
  .factor-card .accent-ln.thick { stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .factor-card .knob { fill: #101013; }
</style>
