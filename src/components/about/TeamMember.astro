---
// Team member card — rebuilt on the redesign system: an elevated surface with
// crafted "living blueprint" portrait chrome (faint grid, metallic corner ticks,
// a metallic index numeral + discipline tag, bottom-fade into the page), the
// shared .lift hover, and token-driven type. Portraits are the real optimized
// WebP headshots (never AI-regenerated).
interface Props {
  name: string;
  role: string;
  bio?: string;
  areasOfFocus?: string[];
  image?: string;
  photoPosition?: string;
  index?: string;
  discipline?: string;
  class?: string;
}

const {
  name,
  role,
  bio,
  areasOfFocus = [],
  image: imageProp,
  photoPosition: photoPositionProp,
  index = '01',
  discipline,
  class: className,
} = Astro.props;

// Optimized WebP headshots (see public/images/team/*.webp). Falls back by name
// when the CMS provides no image, matching the graceful-fallback pattern.
const fallbackImages: Record<string, string> = {
  'Harrison Kipper': '/images/team/Harry_Headshot.webp',
  'Erik Kleiman': '/images/team/Erik_Headshot.webp',
};

// Erik's headshot frames better slightly lower than centre.
const fallbackPhotoPositions: Record<string, string> = {
  'Erik Kleiman': 'object-[center_30%]',
};

// Derive a discipline tag from the role when one isn't passed (design vs dev is
// the "no handoffs" story, so it earns a place on the portrait).
const disciplineTag =
  discipline || (/(dev|engineer|build)/i.test(role) ? 'Development' : 'Design');

const image = imageProp || fallbackImages[name];
const photoPosition =
  photoPositionProp || fallbackPhotoPositions[name] || 'object-top';
---

<article
  class:list={[
    'team-card group surface-elevated lift relative flex flex-col overflow-hidden h-full',
    className,
  ]}
>
  <!-- Portrait Area -->
  <div class="relative aspect-[4/5] overflow-hidden bg-surface-raised">
    <!-- Faint blueprint grid -->
    <div
      class="absolute inset-0 pointer-events-none opacity-70 z-[1]"
      aria-hidden="true"
      style="background-image: linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px); background-size: 26px 26px;"
    >
    </div>

    {image ? (
      <img
        src={image}
        alt={`${name}, ${role} at HEK Design Studio`}
        width="900"
        height="1125"
        class:list={[
          'absolute inset-0 w-full h-full object-cover transition-transform duration-[600ms] ease-out group-hover:scale-[1.03]',
          photoPosition,
        ]}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="w-20 h-20 bg-surface-overlay border border-border-secondary rounded-full" />
      </div>
    )}

    <!-- Bottom-fade blend into the page background -->
    <div
      class="absolute inset-0 pointer-events-none z-[2]"
      aria-hidden="true"
      style="background: linear-gradient(to top, #09090b 2%, rgba(9,9,11,0.35) 26%, transparent 52%);"
    >
    </div>

    <!-- Metallic corner ticks (brighten on hover) -->
    <span
      class="tick absolute top-3 left-3 w-5 h-5 border-t border-l z-[3]"
      aria-hidden="true"></span>
    <span
      class="tick absolute top-3 right-3 w-5 h-5 border-t border-r z-[3]"
      aria-hidden="true"></span>
    <span
      class="tick absolute bottom-3 left-3 w-5 h-5 border-b border-l z-[3]"
      aria-hidden="true"></span>
    <span
      class="tick absolute bottom-3 right-3 w-5 h-5 border-b border-r z-[3]"
      aria-hidden="true"></span>

    <!-- Index numeral + discipline tag over the fade -->
    <div class="absolute left-5 bottom-4 z-[4] flex items-end gap-3">
      <span
        class="text-metallic text-[44px] leading-none font-semibold tabular-nums"
      >{index}</span>
      <span
        class="mb-1.5 text-caption uppercase tracking-[0.22em] text-accent-bronze-bright/90"
      >{disciplineTag}</span>
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-[4] flex flex-col gap-4 p-6 sm:p-7 flex-1">
    <!-- Name & role -->
    <div>
      <h3 class="text-h3-lg font-medium text-white inline-block relative name">
        {name}
        <!-- Metallic underline sweep on hover -->
        <span
          class="absolute -bottom-1 left-0 h-px w-full origin-left scale-x-0 bg-gradient-to-r from-accent-bronze-bright to-transparent transition-transform duration-500 ease-out group-hover:scale-x-100"
          aria-hidden="true"></span>
      </h3>
      <p class="text-caption text-text-secondary mt-2">{role}</p>
    </div>

    <!-- Bio -->
    {bio && <p class="text-body text-text-secondary">{bio}</p>}

    <!-- Areas of focus -->
    {areasOfFocus.length > 0 && (
      <div class="mt-auto pt-2">
        <p class="text-caption uppercase tracking-[0.18em] text-text-muted mb-3">
          Areas of focus
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-2">
          {areasOfFocus.map((area) => (
            <li class="text-body text-text-secondary flex items-start gap-2.5">
              <span
                class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full"
                style="background: var(--gradient-bronze);"
                aria-hidden="true"></span>
              {area}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</article>

<style>
  .team-card .tick {
    border-color: rgba(224, 162, 96, 0.35);
    transition: border-color 0.4s var(--ease-out-expo);
  }
  .team-card:hover .tick {
    border-color: var(--color-accent-bronze-bright);
  }
  @media (prefers-reduced-motion: reduce) {
    .team-card img {
      transition: none;
    }
  }
</style>
