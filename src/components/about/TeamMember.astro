---
// Team member — a compact horizontal "spec plate": a small framed blueprint
// portrait beside a tidy spec-sheet (index + discipline, name, role, bio, and
// focus areas as pills). Elevated surface + shared .lift, token-driven type.
// Portraits are the real optimized WebP headshots (never AI-regenerated).
interface Props {
  name: string;
  role: string;
  bio?: string;
  areasOfFocus?: string[];
  image?: string;
  photoPosition?: string;
  index?: string;
  discipline?: string;
  class?: string;
}

const {
  name,
  role,
  bio,
  areasOfFocus = [],
  image: imageProp,
  photoPosition: photoPositionProp,
  index = '01',
  discipline,
  class: className,
} = Astro.props;

const fallbackImages: Record<string, string> = {
  'Harrison Kipper': '/images/team/Harry_Headshot.webp',
  'Erik Kleiman': '/images/team/Erik_Headshot.webp',
};
const fallbackPhotoPositions: Record<string, string> = {
  'Erik Kleiman': 'object-[center_30%]',
};

const disciplineTag =
  discipline || (/(dev|engineer|build)/i.test(role) ? 'Development' : 'Design');

const image = imageProp || fallbackImages[name];
const photoPosition =
  photoPositionProp || fallbackPhotoPositions[name] || 'object-top';

// Keep the bio short so the tile stays compact at every screen size: take whole
// sentences up to a soft cap (never mid-word), so both CMS and fallback bios read
// as a crisp intro rather than a wall of text.
function trimBio(text: string | undefined, maxChars = 190): string {
  if (!text) return '';
  const sentences = text.match(/[^.!?]+[.!?]+/g);
  if (!sentences) return text.trim();
  let out = '';
  for (const sentence of sentences) {
    if (out && (out + sentence).length > maxChars) break;
    out += sentence;
  }
  return (out || sentences[0]).trim();
}
const shortBio = trimBio(bio);
---

<article
  class:list={[
    'team-card group surface-elevated lift relative flex flex-col p-4 sm:p-5 h-full',
    className,
  ]}
>
  <!-- Header: small framed portrait + identity -->
  <div class="flex items-center gap-4">
    <!-- Portrait plate (small, contained, framed in blueprint chrome) -->
    <div class="relative shrink-0 w-[92px] sm:w-[104px]">
      <div class="relative aspect-[4/5] rounded-lg overflow-hidden bg-surface-raised">
        <!-- Faint blueprint grid -->
        <div
          class="absolute inset-0 pointer-events-none opacity-70 z-[1]"
          aria-hidden="true"
          style="background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 18px 18px;"
        >
        </div>

        {image ? (
          <img
            src={image}
            alt={`${name}, ${role} at HEK Design Studio`}
            width="208"
            height="260"
            class:list={[
              'absolute inset-0 w-full h-full object-cover transition-transform duration-[600ms] ease-out group-hover:scale-[1.04]',
              photoPosition,
            ]}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-9 h-9 bg-surface-overlay border border-border-secondary rounded-full" />
          </div>
        )}

        <!-- Subtle bottom vignette for depth -->
        <div
          class="absolute inset-0 pointer-events-none z-[2]"
          aria-hidden="true"
          style="background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 45%);"
        >
        </div>

        <!-- Metallic corner ticks (brighten on hover) -->
        <span class="tick absolute top-1.5 left-1.5 w-3 h-3 border-t border-l z-[3]" aria-hidden="true"></span>
        <span class="tick absolute top-1.5 right-1.5 w-3 h-3 border-t border-r z-[3]" aria-hidden="true"></span>
        <span class="tick absolute bottom-1.5 left-1.5 w-3 h-3 border-b border-l z-[3]" aria-hidden="true"></span>
        <span class="tick absolute bottom-1.5 right-1.5 w-3 h-3 border-b border-r z-[3]" aria-hidden="true"></span>
      </div>
    </div>

    <!-- Identity -->
    <div class="min-w-0">
      <div class="flex items-center gap-2.5 mb-1">
        <span class="text-metallic text-[24px] leading-none font-semibold tabular-nums">{index}</span>
        <span class="text-caption uppercase tracking-[0.2em] text-accent-bronze-bright/90">{disciplineTag}</span>
      </div>
      <h3 class="text-h3 font-medium text-white relative inline-block name">
        {name}
        <span
          class="absolute -bottom-1 left-0 h-px w-full origin-left scale-x-0 bg-gradient-to-r from-accent-bronze-bright to-transparent transition-transform duration-500 ease-out group-hover:scale-x-100"
          aria-hidden="true"></span>
      </h3>
      <p class="text-caption text-text-secondary mt-1.5">{role}</p>
    </div>
  </div>

  <!-- Bio (full width, a succinct read on the role) with a divider above -->
  {shortBio && (
    <p class="text-body text-text-secondary mt-4 pt-4 border-t border-border-primary">
      {shortBio}
    </p>
  )}
</article>

<style>
  .team-card .tick {
    border-color: rgba(224, 162, 96, 0.4);
    transition: border-color 0.4s var(--ease-out-expo);
  }
  .team-card:hover .tick {
    border-color: var(--color-accent-bronze-bright);
  }
  @media (prefers-reduced-motion: reduce) {
    .team-card img {
      transition: none;
    }
  }
</style>
