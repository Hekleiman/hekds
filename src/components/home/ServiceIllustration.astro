---
// Bespoke per-service illustrations — dark "living blueprint" language with a
// single bronze accent. One clear concept each, generous negative space.
interface Props {
  icon?: string;
  class?: string;
}
const { icon = 'strategy', class: className } = Astro.props;
---

<div class:list={['service-ill relative w-full h-full', className]}>
  <svg viewBox="0 0 480 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
    <defs>
      <linearGradient id="mBronze" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#cd7f32" />
        <stop offset="0.5" stop-color="#e6b878" />
        <stop offset="1" stop-color="#cd7f32" />
      </linearGradient>
      <linearGradient id="mSilver" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#a8a8a8" />
        <stop offset="0.5" stop-color="#f0f0f0" />
        <stop offset="1" stop-color="#a8a8a8" />
      </linearGradient>
      <linearGradient id="mGold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#c9a227" />
        <stop offset="0.5" stop-color="#ffe89a" />
        <stop offset="1" stop-color="#c9a227" />
      </linearGradient>
      <pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 0H0V24" fill="none" stroke="rgba(255,255,255,0.035)" stroke-width="1" />
      </pattern>
    </defs>

    <!-- faint blueprint grid -->
    <rect x="0" y="0" width="480" height="360" fill="url(#grid)" />

    {icon === 'strategy' && (
      <g>
        <!-- User-flow map: connected nodes, one highlighted path -->
        <path d="M150 116 C 220 116, 240 94, 300 94" class="ln dash" />
        <path d="M104 148 C 104 210, 140 214, 176 244" class="ln dash" />
        <path d="M360 128 C 360 196, 356 214, 372 240" class="accent-ln" />

        <!-- Node A -->
        <rect x="58" y="92" width="92" height="52" rx="10" class="fill-1 ln" />
        <rect x="72" y="108" width="48" height="6" rx="3" class="bar-2" />
        <rect x="72" y="122" width="30" height="6" rx="3" class="bar-1" />

        <!-- Node B (active / bronze) -->
        <rect x="300" y="66" width="120" height="60" rx="10" class="fill-2 accent-stroke" />
        <circle cx="318" cy="84" r="6" class="accent-fill" />
        <rect x="332" y="81" width="66" height="6" rx="3" class="bar-2" />
        <rect x="318" y="100" width="80" height="6" rx="3" class="bar-1" />

        <!-- Node C -->
        <rect x="70" y="246" width="112" height="56" rx="10" class="fill-1 ln" />
        <rect x="86" y="264" width="54" height="6" rx="3" class="bar-2" />
        <rect x="86" y="278" width="72" height="6" rx="3" class="bar-1" />

        <!-- Node D -->
        <rect x="330" y="244" width="112" height="58" rx="10" class="fill-1 ln" />
        <rect x="346" y="262" width="40" height="6" rx="3" class="bar-2" />
        <rect x="346" y="276" width="64" height="6" rx="3" class="bar-1" />

        <!-- joints -->
        <circle cx="360" cy="128" r="4" class="accent-fill pulse" />
        <circle cx="150" cy="116" r="3.5" class="dot" />
        <circle cx="104" cy="148" r="3.5" class="dot" />
      </g>
    )}

    {icon === 'design' && (
      <g>
        <!-- Design system: type scale, metallic swatches, a component chip -->
        <!-- type scale -->
        <rect x="52" y="72" width="150" height="16" rx="4" class="bar-2" />
        <rect x="52" y="102" width="112" height="11" rx="4" class="bar-1" />
        <rect x="52" y="126" width="132" height="8" rx="4" class="bar-0" />
        <rect x="52" y="144" width="90" height="8" rx="4" class="bar-0" />

        <!-- divider -->
        <line x1="52" y1="184" x2="428" y2="184" class="ln" />

        <!-- metallic swatches -->
        <rect x="52" y="208" width="60" height="60" rx="12" fill="url(#mBronze)" />
        <rect x="124" y="208" width="60" height="60" rx="12" fill="url(#mSilver)" />
        <rect x="196" y="208" width="60" height="60" rx="12" fill="url(#mGold)" />
        <rect x="268" y="208" width="60" height="60" rx="12" fill="#3f3f46" />
        <rect x="340" y="208" width="60" height="60" rx="12" class="fill-1 ln" />

        <!-- component chip (right) -->
        <rect x="300" y="72" width="128" height="86" rx="12" class="fill-2 ln" />
        <rect x="316" y="122" width="72" height="20" rx="10" class="accent-fill" />
        <circle cx="410" cy="90" r="6" class="dot" />
        <rect x="316" y="90" width="52" height="8" rx="4" class="bar-1" />

        <!-- swatch labels -->
        <rect x="60" y="284" width="44" height="6" rx="3" class="bar-0" />
        <rect x="132" y="284" width="44" height="6" rx="3" class="bar-0" />
        <rect x="204" y="284" width="44" height="6" rx="3" class="bar-0" />
      </g>
    )}

    {icon === 'code' && (
      <g>
        <!-- Editor + ship: code lines with bronze keywords, deploy bar -->
        <rect x="52" y="64" width="376" height="196" rx="14" class="fill-2 ln" />
        <line x1="52" y1="98" x2="428" y2="98" class="ln" />
        <circle cx="72" cy="81" r="4" class="dot" />
        <circle cx="86" cy="81" r="4" class="dot" />
        <circle cx="100" cy="81" r="4" class="dot" />

        <!-- code lines (indent + width vary; some bronze) -->
        <rect x="72" y="120" width="44" height="7" rx="3.5" class="accent-fill" />
        <rect x="124" y="120" width="70" height="7" rx="3.5" class="bar-1" />
        <rect x="92" y="140" width="120" height="7" rx="3.5" class="bar-0" />
        <rect x="92" y="160" width="60" height="7" rx="3.5" class="accent-fill" />
        <rect x="160" y="160" width="96" height="7" rx="3.5" class="bar-0" />
        <rect x="112" y="180" width="150" height="7" rx="3.5" class="bar-0" />
        <rect x="92" y="200" width="52" height="7" rx="3.5" class="bar-1" />
        <rect x="72" y="228" width="40" height="7" rx="3.5" class="accent-fill" />
        <rect x="120" y="228" width="84" height="7" rx="3.5" class="bar-0" />

        <!-- deploy / launch bar -->
        <rect x="52" y="286" width="376" height="30" rx="15" class="fill-1 ln" />
        <rect x="52" y="286" width="248" height="30" rx="15" class="accent-fill soft" />
        <path d="M356 301 l 10 -8 v 5 h 16 v 6 h -16 v 5 z" class="accent-fill" />
      </g>
    )}

    {icon === 'settings' && (
      <g>
        <!-- Analytics: upward trend line + stat blocks + gauge -->
        <rect x="52" y="60" width="256" height="150" rx="14" class="fill-2 ln" />
        <!-- gridlines -->
        <line x1="52" y1="110" x2="308" y2="110" class="ln faint" />
        <line x1="52" y1="150" x2="308" y2="150" class="ln faint" />
        <!-- area + line -->
        <path d="M72 184 L 120 158 L 160 168 L 208 128 L 252 138 L 292 92 L 292 196 L 72 196 Z" class="accent-area" />
        <path d="M72 184 L 120 158 L 160 168 L 208 128 L 252 138 L 292 92" class="accent-ln thick" />
        <circle cx="292" cy="92" r="5" class="accent-fill pulse" />

        <!-- stat block -->
        <rect x="52" y="234" width="150" height="82" rx="12" class="fill-1 ln" />
        <rect x="70" y="252" width="60" height="9" rx="4" class="bar-2" />
        <rect x="70" y="272" width="100" height="7" rx="3.5" class="bar-0" />
        <rect x="70" y="292" width="46" height="7" rx="3.5" class="accent-fill" />

        <!-- gauge -->
        <g transform="translate(342 246)">
          <path d="M -44 40 A 56 56 0 1 1 44 40" class="ln thick" />
          <path d="M -44 40 A 56 56 0 0 1 30 -47" class="accent-ln thick round" />
          <rect x="-20" y="20" width="40" height="8" rx="4" class="bar-1" />
        </g>
      </g>
    )}
  </svg>
</div>

<style>
  .service-ill svg { display: block; }

  .ln { stroke: rgba(255, 255, 255, 0.16); stroke-width: 1.5; }
  .ln.faint { stroke: rgba(255, 255, 255, 0.07); }
  .ln.thick { stroke-width: 2.5; }
  .ln.round { stroke-linecap: round; }
  .dash { stroke: rgba(255, 255, 255, 0.16); stroke-width: 1.5; stroke-dasharray: 4 6; }

  .fill-0 { fill: rgba(255, 255, 255, 0.02); }
  .fill-1 { fill: rgba(255, 255, 255, 0.04); }
  .fill-2 { fill: rgba(255, 255, 255, 0.06); }

  .bar-0 { fill: rgba(255, 255, 255, 0.12); }
  .bar-1 { fill: rgba(255, 255, 255, 0.22); }
  .bar-2 { fill: rgba(255, 255, 255, 0.42); }

  .dot { fill: rgba(255, 255, 255, 0.28); }

  .accent-fill { fill: var(--color-accent-bronze-bright); }
  .accent-fill.soft { fill: rgba(224, 162, 96, 0.28); }
  .accent-stroke { stroke: var(--color-accent-bronze-bright); stroke-width: 1.5; fill: rgba(224, 162, 96, 0.06); }
  .accent-ln { stroke: var(--color-accent-bronze-bright); stroke-width: 2; fill: none; }
  .accent-ln.thick { stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .accent-ln.round { stroke-linecap: round; }
  .accent-area { fill: rgba(224, 162, 96, 0.10); }

  .pulse { animation: ill-pulse 3s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes ill-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse { animation: none; }
  }
</style>
