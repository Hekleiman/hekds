---
// Bespoke per-service illustrations — dark "living blueprint" language with a
// single bronze accent. Every element is placed on exact coordinates so nothing
// is misaligned; connectors meet edges, repeated items are symmetric, and all
// arcs have endpoints that lie exactly on their radius.
// Canvas: 480 x 360. Content margin: ~48px.
interface Props {
  icon?: string;
  class?: string;
}
const { icon = 'strategy', class: className } = Astro.props;
---

<div class:list={['service-ill relative w-full h-full', className]}>
  <svg viewBox="0 0 480 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
    <defs>
      <linearGradient id="mBronze" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#cd7f32" />
        <stop offset="0.5" stop-color="#e6b878" />
        <stop offset="1" stop-color="#cd7f32" />
      </linearGradient>
      <linearGradient id="mSilver" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#a8a8a8" />
        <stop offset="0.5" stop-color="#f0f0f0" />
        <stop offset="1" stop-color="#a8a8a8" />
      </linearGradient>
      <linearGradient id="mGold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#c9a227" />
        <stop offset="0.5" stop-color="#ffe89a" />
        <stop offset="1" stop-color="#c9a227" />
      </linearGradient>
      <pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 0H0V24" fill="none" stroke="rgba(255,255,255,0.035)" stroke-width="1" />
      </pattern>
    </defs>

    <!-- faint blueprint grid -->
    <rect x="0" y="0" width="480" height="360" fill="url(#grid)" />

    {icon === 'strategy' && (
      <g>
        <!-- User journey → three screens in a flow, last one is the goal.
             Journey track sits directly above the node centres (96 / 240 / 384). -->
        <line x1="96" y1="104" x2="384" y2="104" class="dash" />
        <circle cx="96" cy="104" r="4" class="dot" />
        <circle cx="240" cy="104" r="4" class="dot" />
        <circle cx="384" cy="104" r="4" class="accent-fill pulse" />

        <!-- Node 1 -->
        <rect x="46" y="142" width="100" height="76" rx="12" class="fill-1 ln" />
        <rect x="60" y="158" width="72" height="8" rx="4" class="bar-1" />
        <rect x="60" y="176" width="52" height="6" rx="3" class="bar-0" />
        <rect x="60" y="190" width="64" height="6" rx="3" class="bar-0" />

        <!-- Node 2 -->
        <rect x="190" y="142" width="100" height="76" rx="12" class="fill-1 ln" />
        <rect x="204" y="158" width="72" height="8" rx="4" class="bar-1" />
        <rect x="204" y="176" width="52" height="6" rx="3" class="bar-0" />
        <rect x="204" y="190" width="64" height="6" rx="3" class="bar-0" />

        <!-- Node 3 (goal / bronze) -->
        <rect x="334" y="142" width="100" height="76" rx="12" class="fill-2 accent-stroke" />
        <rect x="348" y="158" width="72" height="8" rx="4" class="accent-fill" />
        <rect x="348" y="176" width="52" height="6" rx="3" class="bar-1" />
        <rect x="348" y="190" width="64" height="6" rx="3" class="bar-0" />

        <!-- Connector 1 → 2 (neutral) -->
        <line x1="146" y1="180" x2="184" y2="180" class="ln" />
        <path d="M184 175 L190 180 L184 185 Z" class="bar-1" />

        <!-- Connector 2 → 3 (bronze, leads to the goal) -->
        <line x1="290" y1="180" x2="328" y2="180" class="accent-ln" />
        <path d="M328 175 L334 180 L328 185 Z" class="accent-fill" />
      </g>
    )}

    {icon === 'design' && (
      <g>
        <!-- Design system: type scale (left), a component card (right),
             and a full, evenly-spaced swatch row — every swatch labelled. -->
        <!-- type scale -->
        <rect x="48" y="64" width="140" height="18" rx="4" class="bar-2" />
        <rect x="48" y="92" width="104" height="12" rx="3" class="bar-1" />
        <rect x="48" y="112" width="124" height="8" rx="3" class="bar-0" />
        <rect x="48" y="126" width="88" height="8" rx="3" class="bar-0" />

        <!-- component card -->
        <rect x="286" y="60" width="146" height="92" rx="14" class="fill-2 ln" />
        <rect x="304" y="78" width="64" height="8" rx="4" class="bar-1" />
        <circle cx="414" cy="82" r="5" class="dot" />
        <rect x="304" y="104" width="84" height="24" rx="12" class="accent-fill" />
        <rect x="304" y="138" width="104" height="6" rx="3" class="bar-0" />

        <!-- divider -->
        <line x1="48" y1="176" x2="432" y2="176" class="ln" />

        <!-- swatch row (5 across, gap 26) -->
        <rect x="48" y="200" width="56" height="56" rx="12" fill="url(#mBronze)" />
        <rect x="130" y="200" width="56" height="56" rx="12" fill="url(#mSilver)" />
        <rect x="212" y="200" width="56" height="56" rx="12" fill="url(#mGold)" />
        <rect x="294" y="200" width="56" height="56" rx="12" fill="#3f3f46" />
        <rect x="376" y="200" width="56" height="56" rx="12" class="fill-1 ln" />

        <!-- swatch labels (centred under each swatch) -->
        <rect x="58" y="270" width="36" height="6" rx="3" class="bar-0" />
        <rect x="140" y="270" width="36" height="6" rx="3" class="bar-0" />
        <rect x="222" y="270" width="36" height="6" rx="3" class="bar-0" />
        <rect x="304" y="270" width="36" height="6" rx="3" class="bar-0" />
        <rect x="386" y="270" width="36" height="6" rx="3" class="bar-0" />
      </g>
    )}

    {icon === 'code' && (
      <g>
        <!-- Editor window + a clean deploy progress bar with a knob. -->
        <rect x="48" y="56" width="384" height="192" rx="14" class="fill-2 ln" />
        <line x1="48" y1="88" x2="432" y2="88" class="ln" />
        <circle cx="66" cy="72" r="4" class="dot" />
        <circle cx="82" cy="72" r="4" class="dot" />
        <circle cx="98" cy="72" r="4" class="dot" />
        <!-- active file tab -->
        <rect x="122" y="66" width="96" height="16" rx="5" class="fill-1 ln" />
        <rect x="132" y="72" width="58" height="4" rx="2" class="bar-0" />

        <!-- code lines (consistent gutter at x=68, indents in multiples of 20) -->
        <rect x="68" y="108" width="40" height="7" rx="3.5" class="accent-fill" />
        <rect x="116" y="108" width="66" height="7" rx="3.5" class="bar-1" />
        <rect x="88" y="130" width="120" height="7" rx="3.5" class="bar-0" />
        <rect x="88" y="152" width="54" height="7" rx="3.5" class="bar-0" />
        <rect x="150" y="152" width="78" height="7" rx="3.5" class="bar-0" />
        <rect x="88" y="174" width="46" height="7" rx="3.5" class="accent-fill" />
        <rect x="142" y="174" width="96" height="7" rx="3.5" class="bar-0" />
        <rect x="108" y="196" width="118" height="7" rx="3.5" class="bar-0" />
        <rect x="68" y="218" width="42" height="7" rx="3.5" class="accent-fill" />
        <rect x="118" y="218" width="72" height="7" rx="3.5" class="bar-0" />

        <!-- deploy progress bar -->
        <rect x="48" y="272" width="384" height="28" rx="14" class="fill-1 ln" />
        <rect x="48" y="272" width="246" height="28" rx="14" class="accent-fill soft" />
        <circle cx="294" cy="286" r="8" class="accent-fill" />
        <circle cx="294" cy="286" r="3" class="knob-core" />
      </g>
    )}

    {icon === 'settings' && (
      <g>
        <!-- Analytics: trend chart (top), stat block + a correct semicircle gauge. -->
        <rect x="48" y="56" width="268" height="150" rx="14" class="fill-2 ln" />
        <line x1="64" y1="96" x2="300" y2="96" class="ln faint" />
        <line x1="64" y1="136" x2="300" y2="136" class="ln faint" />
        <line x1="64" y1="176" x2="300" y2="176" class="ln faint" />
        <path d="M68 172 L114 150 L160 158 L206 120 L252 132 L300 86 L300 190 L68 190 Z" class="accent-area" />
        <path d="M68 172 L114 150 L160 158 L206 120 L252 132 L300 86" class="accent-ln thick" />
        <circle cx="300" cy="86" r="5" class="accent-fill pulse" />

        <!-- stat block -->
        <rect x="48" y="224" width="150" height="88" rx="14" class="fill-1 ln" />
        <rect x="66" y="244" width="58" height="8" rx="4" class="bar-1" />
        <rect x="66" y="264" width="96" height="16" rx="4" class="bar-2" />
        <rect x="66" y="292" width="44" height="7" rx="3.5" class="accent-fill" />

        <!-- circular progress gauge (perfect circles — track + ~72% ring).
             dasharray on a full circle avoids any arc-endpoint issues. -->
        <circle cx="330" cy="268" r="42" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="8" />
        <circle
          cx="330" cy="268" r="42" fill="none"
          stroke="var(--color-accent-bronze-bright)" stroke-width="8" stroke-linecap="round"
          stroke-dasharray="190 264" transform="rotate(-90 330 268)"
        />
        <rect x="314" y="264" width="32" height="8" rx="4" class="bar-2" />
      </g>
    )}
  </svg>
</div>

<style>
  .service-ill svg { display: block; }

  .ln { stroke: rgba(255, 255, 255, 0.16); stroke-width: 1.5; }
  .ln.faint { stroke: rgba(255, 255, 255, 0.07); }
  .ln.thick { stroke-width: 2.5; }
  .dash { stroke: rgba(255, 255, 255, 0.14); stroke-width: 1.5; stroke-dasharray: 3 6; }

  .fill-1 { fill: rgba(255, 255, 255, 0.04); }
  .fill-2 { fill: rgba(255, 255, 255, 0.06); }

  .bar-0 { fill: rgba(255, 255, 255, 0.12); }
  .bar-1 { fill: rgba(255, 255, 255, 0.24); }
  .bar-2 { fill: rgba(255, 255, 255, 0.44); }

  .dot { fill: rgba(255, 255, 255, 0.28); }
  .knob-core { fill: #101013; }

  .accent-fill { fill: var(--color-accent-bronze-bright); }
  .accent-fill.soft { fill: rgba(224, 162, 96, 0.26); }
  .accent-stroke { stroke: var(--color-accent-bronze-bright); stroke-width: 1.5; fill: rgba(224, 162, 96, 0.06); }
  .accent-ln { stroke: var(--color-accent-bronze-bright); stroke-width: 2; fill: none; }
  .accent-ln.thick { stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .accent-area { fill: rgba(224, 162, 96, 0.10); }

  .pulse { animation: ill-pulse 3s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes ill-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse { animation: none; }
  }
</style>
