---
// Hero showcase: a refined interface "assembling" from a blueprint underlay —
// the through-line of the whole page, rendered in the dark + bronze system.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['hero-visual relative w-full', className]} aria-hidden="true">
  <!-- soft glow -->
  <div
    class="absolute -inset-8 -z-10"
    style="background: radial-gradient(60% 60% at 50% 40%, rgba(224,162,96,0.12), transparent 70%);"
  >
  </div>

  <svg viewBox="0 0 960 600" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
    <defs>
      <linearGradient id="hv-panel" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#232328" />
        <stop offset="1" stop-color="#161619" />
      </linearGradient>
      <linearGradient id="hv-bronze" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#cd7f32" />
        <stop offset="0.5" stop-color="#e6b878" />
        <stop offset="1" stop-color="#cd7f32" />
      </linearGradient>
      <pattern id="hv-grid" width="30" height="30" patternUnits="userSpaceOnUse">
        <path d="M30 0H0V30" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1" />
      </pattern>
    </defs>

    <!-- blueprint underlay (left) -->
    <g class="blueprint">
      <rect x="16" y="70" width="360" height="500" fill="url(#hv-grid)" />
      <line x1="40" y1="70" x2="40" y2="570" class="guide" />
      <path d="M40 92 h -12 M40 92 v 0" class="guide" />
      <circle cx="40" cy="150" r="4" class="guide-dot" />
      <circle cx="40" cy="330" r="4" class="guide-dot" />
      <path d="M60 545 h 80" class="guide" />
      <path d="M60 540 v 10 M140 540 v 10" class="guide" />
    </g>

    <!-- browser window -->
    <g class="window">
      <rect x="60" y="48" width="840" height="504" rx="18" fill="url(#hv-panel)" stroke="rgba(255,255,255,0.10)" />
      <!-- top bar -->
      <line x1="60" y1="92" x2="900" y2="92" stroke="rgba(255,255,255,0.08)" />
      <circle cx="86" cy="70" r="5" class="dot" />
      <circle cx="104" cy="70" r="5" class="dot" />
      <circle cx="122" cy="70" r="5" class="dot" />
      <rect x="300" y="60" width="360" height="20" rx="10" class="fill-1 ln" />
      <circle cx="322" cy="70" r="4" class="accent-fill" />

      <!-- site nav -->
      <circle cx="100" cy="128" r="7" class="accent-fill" />
      <rect x="116" y="124" width="46" height="8" rx="4" class="bar-2" />
      <rect x="590" y="124" width="40" height="8" rx="4" class="bar-0" />
      <rect x="646" y="124" width="40" height="8" rx="4" class="bar-0" />
      <rect x="702" y="120" width="70" height="18" rx="9" class="accent-soft" />

      <!-- headline block -->
      <rect x="100" y="192" width="300" height="22" rx="6" class="bar-2" />
      <rect x="100" y="224" width="360" height="22" rx="6" class="bar-2" />
      <rect x="100" y="256" width="220" height="22" rx="6" class="accent-fill" />

      <!-- body copy -->
      <rect x="100" y="308" width="300" height="9" rx="4.5" class="bar-0" />
      <rect x="100" y="326" width="264" height="9" rx="4.5" class="bar-0" />

      <!-- buttons -->
      <rect x="100" y="372" width="132" height="40" rx="20" fill="url(#hv-bronze)" />
      <rect x="248" y="372" width="120" height="40" rx="20" class="fill-1 ln" />

      <!-- product card (right) -->
      <rect x="516" y="176" width="316" height="300" rx="16" class="fill-2 ln" />
      <rect x="540" y="200" width="120" height="10" rx="5" class="bar-1" />
      <rect x="540" y="220" width="70" height="8" rx="4" class="bar-0" />
      <!-- mini chart -->
      <line x1="540" y1="300" x2="808" y2="300" class="ln faint" />
      <line x1="540" y1="352" x2="808" y2="352" class="ln faint" />
      <path d="M540 388 L 588 356 L 636 366 L 690 316 L 744 330 L 808 268 L 808 404 L 540 404 Z" class="accent-area" />
      <path d="M540 388 L 588 356 L 636 366 L 690 316 L 744 330 L 808 268" class="accent-line" />
      <circle cx="808" cy="268" r="5" class="accent-fill pulse" />
      <rect x="540" y="430" width="90" height="26" rx="8" class="fill-1 ln" />
      <rect x="648" y="430" width="90" height="26" rx="8" class="fill-1 ln" />
    </g>

    <!-- floating metric card (depth) -->
    <g class="floater">
      <rect x="60" y="440" width="196" height="104" rx="16" fill="url(#hv-panel)" stroke="rgba(255,255,255,0.12)" />
      <rect x="80" y="462" width="70" height="8" rx="4" class="bar-1" />
      <rect x="80" y="486" width="110" height="16" rx="5" class="bar-2" />
      <path d="M80 522 L 108 512 L 132 518 L 160 500 L 190 506 L 232 490" class="accent-line" />
      <circle cx="232" cy="490" r="4" class="accent-fill" />
    </g>
  </svg>
</div>

<style>
  .hero-visual svg { display: block; }

  .ln { stroke: rgba(255, 255, 255, 0.12); stroke-width: 1.5; }
  .ln.faint { stroke: rgba(255, 255, 255, 0.06); }
  .guide { stroke: rgba(224, 162, 96, 0.30); stroke-width: 1; stroke-dasharray: 3 5; }
  .guide-dot { fill: rgba(224, 162, 96, 0.5); }

  .fill-1 { fill: rgba(255, 255, 255, 0.04); }
  .fill-2 { fill: rgba(255, 255, 255, 0.03); }

  .bar-0 { fill: rgba(255, 255, 255, 0.12); }
  .bar-1 { fill: rgba(255, 255, 255, 0.24); }
  .bar-2 { fill: rgba(255, 255, 255, 0.5); }
  .dot { fill: rgba(255, 255, 255, 0.22); }

  .accent-fill { fill: var(--color-accent-bronze-bright); }
  .accent-soft { fill: rgba(224, 162, 96, 0.22); }
  .accent-area { fill: rgba(224, 162, 96, 0.12); }
  .accent-line { stroke: var(--color-accent-bronze-bright); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; fill: none; }

  .floater { animation: hv-float 6s var(--ease-out-soft, ease-in-out) infinite; transform-box: view-box; }
  @keyframes hv-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .pulse { animation: hv-pulse 3s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes hv-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  @media (prefers-reduced-motion: reduce) {
    .floater, .pulse { animation: none; }
  }
</style>
