---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';

interface Props {
  headlineLine1?: string;
  headlineLine2?: string;
  headlineLine3?: string;
  subtext?: string;
  primaryCta?: { text: string; href: string };
  secondaryCta?: { text: string; href: string };
  class?: string;
}

const {
  headlineLine1 = 'Designing and building',
  headlineLine2 = 'modern websites',
  headlineLine3 = 'with clarity and intention.',
  subtext = 'A design and development partnership focused on creating exceptional digital experiences. Direct collaboration, thoughtful execution, no handoffs.',
  primaryCta = { text: 'Start a Project →', href: '/contact' },
  secondaryCta = { text: '⊕ View Our Work', href: '/work' },
  class: className,
} = Astro.props;
---

<Section
  class:list={['relative min-h-screen flex items-center overflow-hidden pb-0', className]}
  data-animate="hero"
  data-spotlight
>
  <!-- Depth glows -->
  <div class="aura w-[520px] h-[520px] -top-24 left-1/2 -translate-x-1/2 bg-accent-bronze/10"></div>
  <div class="aura w-[380px] h-[380px] bottom-0 right-[8%] bg-white/[0.03]"></div>

  <!-- Living-blueprint contour layer (draws in, parallaxes gently) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.55]"
    aria-hidden="true"
    data-parallax
    data-parallax-speed="-0.12"
  >
    <svg
      class="w-full h-full"
      viewBox="0 0 1440 900"
      fill="none"
      preserveAspectRatio="xMidYMid slice"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M-40 620 C 220 560, 380 700, 620 640 S 1080 520, 1500 600"
        stroke="var(--color-border-secondary)"
        stroke-width="1"
        data-draw="hero"
      />
      <path
        d="M-40 700 C 260 640, 420 780, 700 710 S 1140 600, 1500 680"
        stroke="var(--color-border-primary)"
        stroke-width="1"
        data-draw="hero"
      />
      <path
        d="M-40 540 C 200 500, 460 600, 720 540 S 1120 440, 1500 520"
        stroke="var(--color-border-primary)"
        stroke-width="1"
        data-draw="hero"
      />
    </svg>
  </div>

  <!-- Cursor spotlight: a light passing over the blueprint (pointer-fine only) -->
  <div
    class="absolute w-[600px] h-[600px] rounded-full opacity-0 pointer-events-none mix-blend-screen -ml-[300px] -mt-[300px]"
    style="background: radial-gradient(circle, rgba(224,162,96,0.12) 0%, rgba(224,162,96,0.05) 35%, transparent 70%);"
    aria-hidden="true"
    data-spotlight-light
  >
  </div>

  <div class="relative z-10 w-full flex flex-col items-center text-center">
    <!-- Eyebrow -->
    <div
      class="inline-flex items-start gap-2 mb-8 px-4 py-1.5 rounded-full border border-border-primary bg-background-secondary/60 backdrop-blur-sm"
      data-hero="tag"
    >
      <span class="w-1.5 h-1.5 mt-[7px] shrink-0 rounded-full bg-accent-bronze-bright"></span>
      <span class="text-caption text-text-secondary tracking-wide">A two-person design &amp; development studio</span>
    </div>

    <!-- Headline -->
    <h1 class="hero-headline max-w-[16ch] mb-7" data-hero="headline">
      <span class="block text-white">{headlineLine1}</span>
      <span class="block text-metallic metallic-shimmer">{headlineLine2}</span>
      <span class="block text-white">{headlineLine3}</span>
    </h1>

    <!-- Subheadline -->
    <p class="text-body-lg text-text-secondary max-w-[620px] mb-8" data-hero="subtext">
      {subtext}
    </p>

    <!-- Meta row (absorbs the old floating paragraph, refined) -->
    <div
      class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-caption text-text-muted mb-10"
      data-hero="meta"
    >
      <span>Websites for small businesses &amp; nonprofits</span>
      <span class="w-1 h-1 rounded-full bg-border-secondary"></span>
      <span class="text-text-secondary">Project pricing from <span class="text-accent-bronze-bright font-medium">$500</span></span>
    </div>

    <!-- CTA Group -->
    <div class="flex flex-col sm:flex-row gap-4" data-hero="cta">
      <Button href={primaryCta.href}>{primaryCta.text}</Button>
      <Button href={secondaryCta.href} variant="secondary">{secondaryCta.text}</Button>
    </div>
  </div>

  <!-- Scroll cue -->
  <a
    href="#what-we-do"
    class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-text-muted hover:text-text-secondary transition-colors duration-300"
    data-hero="scroll"
    aria-label="Scroll to what we do"
  >
    <span class="text-caption tracking-widest uppercase text-[11px]">Scroll</span>
    <span class="scroll-cue block w-5 h-8 rounded-full border border-border-secondary relative">
      <span class="scroll-dot"></span>
    </span>
  </a>
</Section>

<style>
  .hero-headline {
    font-weight: 600;
    font-size: clamp(2.75rem, 7.5vw, 5.25rem);
    line-height: 1.03;
    letter-spacing: -0.035em;
  }

  /* Animated dot inside the scroll cue */
  .scroll-dot {
    position: absolute;
    top: 6px;
    left: 50%;
    width: 3px;
    height: 6px;
    margin-left: -1.5px;
    border-radius: 9999px;
    background: var(--color-accent-bronze-bright);
    animation: scroll-bob 1.8s var(--ease-out-soft) infinite;
  }
  @keyframes scroll-bob {
    0% { opacity: 0; transform: translateY(0); }
    30% { opacity: 1; }
    70% { opacity: 1; transform: translateY(8px); }
    100% { opacity: 0; transform: translateY(10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-dot { animation: none; top: 12px; opacity: 1; }
  }
</style>
