---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import HeroVisual from './HeroVisual.astro';

interface Props {
  headlineLine1?: string;
  headlineLine2?: string;
  headlineLine3?: string;
  subtext?: string;
  primaryCta?: { text: string; href: string };
  secondaryCta?: { text: string; href: string };
  class?: string;
}

const {
  headlineLine1 = 'Designing and building',
  headlineLine2 = 'modern websites',
  headlineLine3 = 'with clarity and intention.',
  subtext = 'Direct collaboration, thoughtful execution — no handoffs.',
  primaryCta = { text: 'Start a Project →', href: '/contact' },
  secondaryCta = { text: '⊕ View Our Work', href: '/work' },
  class: className,
} = Astro.props;
---

<Section
  class:list={['relative flex flex-col items-center overflow-hidden pb-20 sm:pb-28', className]}
  data-animate="hero"
  data-spotlight
>
  <!-- Depth glows -->
  <div class="aura w-[520px] h-[520px] -top-24 left-1/2 -translate-x-1/2 bg-accent-bronze/10"></div>

  <!-- Living-blueprint contour layer (draws in, parallaxes gently) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.5]"
    aria-hidden="true"
    data-parallax
    data-parallax-speed="-0.12"
  >
    <svg
      class="w-full h-full"
      viewBox="0 0 1440 900"
      fill="none"
      preserveAspectRatio="xMidYMid slice"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M-40 620 C 220 560, 380 700, 620 640 S 1080 520, 1500 600"
        stroke="var(--color-border-secondary)"
        stroke-width="1"
        data-draw="hero"
      />
      <path
        d="M-40 700 C 260 640, 420 780, 700 710 S 1140 600, 1500 680"
        stroke="var(--color-border-primary)"
        stroke-width="1"
        data-draw="hero"
      />
      <path
        d="M-40 540 C 200 500, 460 600, 720 540 S 1120 440, 1500 520"
        stroke="var(--color-border-primary)"
        stroke-width="1"
        data-draw="hero"
      />
    </svg>
  </div>

  <!-- Cursor spotlight: a light passing over the blueprint (pointer-fine only) -->
  <div
    class="absolute w-[600px] h-[600px] rounded-full opacity-0 pointer-events-none mix-blend-screen -ml-[300px] -mt-[300px]"
    style="background: radial-gradient(circle, rgba(224,162,96,0.12) 0%, rgba(224,162,96,0.05) 35%, transparent 70%);"
    aria-hidden="true"
    data-spotlight-light
  >
  </div>

  <div class="relative z-10 w-full flex flex-col items-center text-center justify-center min-h-[calc(100svh-11rem)]">
    <!-- Eyebrow -->
    <div
      class="inline-flex items-start gap-2 mb-7 px-4 py-1.5 rounded-full border border-border-primary bg-background-secondary/60 backdrop-blur-sm"
      data-hero="tag"
    >
      <span class="w-1.5 h-1.5 mt-[7px] shrink-0 rounded-full bg-accent-bronze-bright"></span>
      <span class="text-caption text-text-secondary tracking-wide">A two-person studio for small businesses &amp; nonprofits</span>
    </div>

    <!-- Headline -->
    <h1 class="hero-headline max-w-[920px] mb-6" data-hero="headline">
      <span class="block text-white">{headlineLine1}</span>
      <span class="block text-metallic metallic-shimmer">{headlineLine2}</span>
      <span class="block text-white">{headlineLine3}</span>
    </h1>

    <!-- Subheadline (concise) -->
    <p class="text-body-lg text-text-secondary max-w-[520px] mb-8" data-hero="subtext">
      {subtext}
    </p>

    <!-- CTA Group -->
    <div class="flex flex-col sm:flex-row items-center gap-4 mb-4" data-hero="cta">
      <Button href={primaryCta.href}>{primaryCta.text}</Button>
      <Button href={secondaryCta.href} variant="secondary">{secondaryCta.text}</Button>
    </div>

    <!-- Pricing note -->
    <p class="text-caption text-text-muted" data-hero="meta">
      Project pricing from <span class="text-accent-bronze-bright font-medium">$500</span>
    </p>
  </div>

  <!-- Showcase visual (sits just below the fold — a scroll tease) -->
  <div class="relative z-10 w-full max-w-[880px] mt-4 sm:mt-6 px-2" data-hero="visual">
    <HeroVisual />
  </div>
</Section>

<style>
  .hero-headline {
    font-weight: 600;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
</style>
