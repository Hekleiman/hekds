---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';

interface Props {
  headline?: string;
  subtext?: string;
  primaryCta?: { text: string; href: string };
  class?: string;
}

const {
  headline = "Let's build something together.",
  subtext = "Every project is different. Whether you need a complete redesign or a new build from scratch, we'd love to hear about it. Pricing varies based on scope and timeline.",
  primaryCta = { text: 'Start a Conversation →', href: '/contact' },
  class: className,
} = Astro.props;

// Apply the metallic accent to the final word of the CMS-provided headline
// (trailing punctuation preserved). Falls back gracefully for one-word strings.
const headlineText = (headline ?? '').trim() || "Let's build something together.";
const match = headlineText.match(/^([\s\S]*\S)\s+(\S+?)([.!?…]*)$/);
const headlineLead = match ? match[1] : '';
const headlineAccent = match ? match[2] : headlineText;
const headlinePunct = match ? match[3] : '';
---

<Section class:list={['relative overflow-hidden border-t border-border-primary', className]}>
  <!-- Glow + contour echo -->
  <div class="aura w-[560px] h-[360px] top-0 left-1/2 -translate-x-1/2 -translate-y-1/3 bg-accent-bronze/[0.09]"></div>
  <div class="absolute inset-0 pointer-events-none opacity-40" aria-hidden="true" data-draw-trigger>
    <svg class="w-full h-full" viewBox="0 0 1440 400" fill="none" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <path d="M-40 250 C 300 180, 560 320, 860 240 S 1200 140, 1500 220" stroke="var(--color-border-secondary)" stroke-width="1" data-draw="scroll"/>
      <path d="M-40 320 C 320 260, 600 380, 900 300 S 1220 210, 1500 290" stroke="var(--color-border-primary)" stroke-width="1" data-draw="scroll"/>
    </svg>
  </div>

  <div class="relative z-10 flex flex-col items-center text-center" data-animate="fade-up">
    <!-- Headline (CMS-editable; metallic accent on the final word) -->
    <h2 class="text-h2 mb-5 max-w-[16ch]">
      {headlineLead && <>{headlineLead}{' '}</>}<span class="text-metallic metallic-shimmer">{headlineAccent}</span>{headlinePunct}
    </h2>

    <!-- Subtext -->
    <p class="text-body-lg text-text-secondary max-w-[640px] mb-9">
      {subtext}
    </p>

    <!-- CTA Button -->
    <Button href={primaryCta.href}>{primaryCta.text}</Button>
  </div>
</Section>
