---
interface Props {
  variant?: 'primary' | 'secondary';
  size?: 'default' | 'small';
  href?: string;
  class?: string;
  type?: 'button' | 'submit';
}

const {
  variant = 'primary',
  size = 'default',
  href,
  class: className,
  type = 'button',
  ...rest
} = Astro.props;

const baseStyles = 'btn inline-flex items-center justify-center rounded-full font-medium text-sm whitespace-nowrap';

// Sizes scale down on small screens so buttons never feel oversized on mobile.
const sizeStyles = {
  default: 'h-11 px-5 sm:h-12 sm:px-6',
  small: 'h-9 px-3.5 sm:h-10 sm:px-5',
};

const variantStyles = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
};

const classes = [
  baseStyles,
  sizeStyles[size],
  variantStyles[variant],
  className,
].filter(Boolean).join(' ');
---

{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} {...rest}>
    <slot />
  </button>
)}
