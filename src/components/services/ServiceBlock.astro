---
import ServiceGraphic from './ServiceGraphic.astro';
import ServiceIcon from './ServiceIcon.astro';
import { resolveIconKey } from '../../lib/serviceIcons';

// A single service row — the fuller, standalone sibling of Home's ServicesIntro
// row: alternating asymmetric layout, a metallic 01–04 index numeral, a bronze
// icon circle, a feature list, a small "process annotation" stat, and a bespoke
// blueprint graphic in an elevated, lifting tile.
interface Props {
  title: string;
  description: string;
  features: string[];
  slug?: string;
  icon?: string;
  index?: number;
  reversed?: boolean;
  class?: string;
}

const {
  title,
  description,
  features,
  slug,
  icon,
  index = 0,
  reversed = false,
  class: className,
} = Astro.props;

// Unify on the Home illustration keys (legacy Sanity keys alias in one place).
const iconKey = resolveIconKey(icon);

const numeral = String(index + 1).padStart(2, '0');

// A small, honest "process annotation" per service — count-up on the number.
const stats: Record<string, { value: string; unit?: string; label: string }> = {
  strategy: { value: '2', unit: 'wks', label: 'to a clickable prototype' },
  design: { value: '1', label: 'design system, every screen' },
  code: { value: '0', label: 'handoffs — we build it' },
  settings: { value: '∞', label: 'ongoing care after launch' },
};
const stat = stats[iconKey];
const statIsNumeric = stat ? /^\d+$/.test(stat.value) : false;
---

<section
  id={slug}
  class:list={['service-block scroll-mt-28', className]}
  data-animate="fade-up"
>
  <div
    class:list={[
      'group grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center',
      reversed && 'lg:[direction:rtl]',
    ]}
  >
    <!-- Text Column -->
    <div class="lg:[direction:ltr]">
      <!-- Metallic index — a "station" on the page's blueprint spine -->
      <div class="flex items-center gap-4 mb-6">
        <span class="service-numeral text-metallic leading-none font-semibold tabular-nums">{numeral}</span>
        <span class="h-px flex-1 max-w-[72px] bg-gradient-to-r from-border-secondary to-transparent"></span>
      </div>

      <!-- Icon -->
      <div class="w-12 h-12 rounded-full bg-surface-raised border border-border-secondary flex items-center justify-center mb-6">
        <ServiceIcon icon={iconKey} />
      </div>

      <!-- Title -->
      <h2 class="text-h3-lg font-medium text-white mb-4">
        {title}
      </h2>

      <!-- Description -->
      <p class="text-body-lg text-text-secondary max-w-[520px] mb-7">
        {description}
      </p>

      <!-- Feature list -->
      <p class="text-caption uppercase tracking-[0.2em] text-text-muted mb-4">What's included</p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 mb-8 max-w-[520px]">
        {features.map((feature) => (
          <li class="flex items-start gap-2.5 text-body text-text-secondary">
            <svg class="mt-[7px] shrink-0 text-accent-bronze-bright" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M2.5 7.5L5.5 10.5L11.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{feature}</span>
          </li>
        ))}
      </ul>

      <!-- Process annotation stat -->
      {stat && (
        <div class="inline-flex items-baseline gap-2.5 rounded-full border border-border-primary bg-background-secondary/60 px-4 py-2">
          <span class="text-metallic text-h3 leading-none font-semibold tabular-nums">
            {statIsNumeric ? <span data-countup={stat.value}>{stat.value}</span> : stat.value}{stat.unit && <span class="text-[0.6em] font-medium ml-0.5">{stat.unit}</span>}
          </span>
          <span class="text-caption text-text-muted">{stat.label}</span>
        </div>
      )}
    </div>

    <!-- Graphic Column -->
    <div class="lg:[direction:ltr]">
      <div class="surface-elevated lift aspect-[16/10] overflow-hidden p-5 sm:p-7">
        <div class="w-full h-full transition-transform duration-500 ease-out group-hover:scale-[1.02]">
          <ServiceGraphic icon={iconKey} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Matches Home's process/index numerals: fluid 40 → 56px so it isn't oversized
     on phones or lost on desktop. */
  .service-numeral {
    font-size: clamp(2.5rem, 1.9rem + 2.4vw, 3.5rem);
  }
</style>
