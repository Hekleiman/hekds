---
import Section from '../ui/Section.astro';

// "How a project runs" — a blueprint timeline unique to the Services page (Home
// has no equivalent; its HowWeWork is a 2x2 grid). A bronze progress line fills
// along the stations as the section scrolls, signifying movement from the first
// step to the last: horizontal (lg+) and a vertical left-rail timeline below lg.
interface Phase {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  phases?: Phase[];
  class?: string;
}

const defaultPhases: Phase[] = [
  {
    title: 'Discover',
    description: 'We map your goals, audience, and scope before any pixels move.',
  },
  {
    title: 'Design',
    description: 'Wireframes become polished, on-brand UI — reviewed together at every step.',
  },
  {
    title: 'Build',
    description: 'Clean, accessible, fast code that turns the design into the real thing.',
  },
  {
    title: 'Launch & care',
    description: "We ship, then keep monitoring and refining well past go-live.",
  },
];

const {
  eyebrow = 'How we work',
  heading = 'How a project runs.',
  description = 'One connected process from first conversation to long after launch — the same two people the whole way.',
  phases = defaultPhases,
  class: className,
} = Astro.props;

const phasesWithNumbers = phases.map((phase, index) => ({
  ...phase,
  number: String(index + 1).padStart(2, '0'),
  last: index === phases.length - 1,
}));

const dotClass = (last: boolean) =>
  last
    ? 'bg-accent-bronze-bright station-live'
    : 'bg-surface-raised border border-border-secondary';
---

<Section class:list={['relative overflow-hidden', className]}>
  <!-- Ambient depth glow — carries the hero/CTA aura through the mid page. -->
  <div class="aura w-[560px] h-[380px] top-0 left-1/2 -translate-x-1/2 -translate-y-1/3 bg-accent-bronze/[0.07]"></div>

  <div class="relative z-10">
    <!-- Header -->
    <div class="mb-14 lg:mb-16 max-w-[640px]" data-animate="fade-up">
      <span class="text-caption uppercase tracking-[0.2em] text-accent-bronze-bright/80">{eyebrow}</span>
      <h2 class="text-h2 mt-3 mb-4">
        {heading}
      </h2>
      <p class="text-body-lg text-text-secondary">
        {description}
      </p>
    </div>

    <div data-progress-trigger data-animate="fade-up">
      <!-- ── Desktop (lg+): horizontal timeline ─────────────────────────────
           A neutral track with a bronze progress fill that grows left→right on
           scroll, threaded through four station dots (centres at 12.5% …). -->
      <div class="hidden lg:block">
        <div class="relative h-4 mb-9">
          <div class="absolute top-1/2 left-[12.5%] right-[12.5%] h-px -translate-y-1/2 bg-border-secondary/70"></div>
          <div
            class="progress-fill-x absolute top-1/2 left-[12.5%] right-[12.5%] h-[2px] -translate-y-1/2"
            data-progress-fill data-progress-axis="x"
          ></div>
          <div class="relative grid grid-cols-4 h-full">
            {phasesWithNumbers.map((phase) => (
              <div class="flex items-center justify-center">
                <span class:list={['w-3.5 h-3.5 rounded-full ring-4 ring-background-primary', dotClass(phase.last)]}></span>
              </div>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-4 gap-x-8">
          {phasesWithNumbers.map((phase) => (
            <div class="text-center">
              <span class="text-metallic block text-[40px] leading-none font-semibold tabular-nums mb-3">{phase.number}</span>
              <h3 class="text-h3 font-medium text-white mb-2">{phase.title}</h3>
              <p class="text-body text-text-secondary max-w-[220px] mx-auto">{phase.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- ── Mobile / tablet (below lg): vertical left-rail timeline ─────────
           Same idea rotated: a bronze progress fill grows top→bottom on scroll
           down the rail, with the stations and phases stacked beside it. -->
      <div class="lg:hidden relative pl-10">
        <!-- Rail: track + bronze fill, bottom softly faded so the line dissolves
             just past the final station instead of hard-stopping in mid-air. -->
        <div class="rail-fade absolute left-[6px] top-2 bottom-2 w-[2px]">
          <div class="absolute inset-0 bg-border-secondary/70"></div>
          <div
            class="progress-fill-y absolute inset-x-0 top-0 h-full"
            data-progress-fill data-progress-axis="y"
          ></div>
        </div>

        <div class="space-y-10">
          {phasesWithNumbers.map((phase) => (
            <div class="relative">
              <span class:list={['absolute -left-10 top-1.5 w-3.5 h-3.5 rounded-full ring-4 ring-background-primary', dotClass(phase.last)]}></span>
              <span class="text-metallic block text-[36px] leading-none font-semibold tabular-nums mb-2">{phase.number}</span>
              <h3 class="text-h3 font-medium text-white mb-2">{phase.title}</h3>
              <p class="text-body text-text-secondary">{phase.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Bronze progress fills — start empty; initProgressLine (animations.ts) scrubs
     them to full with scroll. Default (and reduced-motion) state is full. */
  .progress-fill-x,
  .progress-fill-y {
    background: linear-gradient(var(--pf-angle, 90deg), var(--color-accent-bronze), var(--color-accent-bronze-bright));
    box-shadow: 0 0 10px rgba(224, 162, 96, 0.4);
    border-radius: 2px;
  }
  .progress-fill-x {
    transform-origin: left center;
    transform: scaleX(1);
  }
  .progress-fill-y {
    --pf-angle: 180deg;
    transform-origin: center top;
    transform: scaleY(1);
  }

  /* Soften the rail's bottom so it dissolves just past the final station. */
  .rail-fade {
    -webkit-mask-image: linear-gradient(180deg, #000 85%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 85%, transparent 100%);
  }

  /* The bronze "launch" station breathes — folds the timeline into the living-
     blueprint language (matches the graphics' focal-accent pulse). */
  .station-live {
    animation: station-pulse 3s ease-in-out infinite;
  }
  @keyframes station-pulse {
    0%, 100% { box-shadow: 0 0 12px 1px rgba(224, 162, 96, 0.5); }
    50% { box-shadow: 0 0 5px 0 rgba(224, 162, 96, 0.22); }
  }
  @media (prefers-reduced-motion: reduce) {
    .station-live {
      animation: none;
      box-shadow: 0 0 10px 1px rgba(224, 162, 96, 0.4);
    }
  }
</style>
