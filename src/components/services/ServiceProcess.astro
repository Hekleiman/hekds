---
import Section from '../ui/Section.astro';

// "How a project runs" — a horizontal blueprint timeline unique to the Services
// page (Home has no equivalent; its HowWeWork is a 2x2 grid). A dashed connector
// line draws in across four station dots on scroll (reusing data-draw="scroll"),
// with metallic phase numerals below. Stacks to a numbered list on mobile.
interface Phase {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  phases?: Phase[];
  class?: string;
}

const defaultPhases: Phase[] = [
  {
    title: 'Discover',
    description: 'We map your goals, audience, and scope before any pixels move.',
  },
  {
    title: 'Design',
    description: 'Wireframes become polished, on-brand UI — reviewed together at every step.',
  },
  {
    title: 'Build',
    description: 'Clean, accessible, fast code that turns the design into the real thing.',
  },
  {
    title: 'Launch & care',
    description: "We ship, then keep monitoring and refining well past go-live.",
  },
];

const {
  eyebrow = 'How we work',
  heading = 'How a project runs.',
  description = 'One connected process from first conversation to long after launch — the same two people the whole way.',
  phases = defaultPhases,
  class: className,
} = Astro.props;

const phasesWithNumbers = phases.map((phase, index) => ({
  ...phase,
  number: String(index + 1).padStart(2, '0'),
  last: index === phases.length - 1,
}));
---

<Section class:list={[className]}>
  <!-- Header -->
  <div class="mb-14 lg:mb-16 max-w-[640px]" data-animate="fade-up">
    <span class="text-caption uppercase tracking-[0.2em] text-accent-bronze-bright/80">{eyebrow}</span>
    <h2 class="text-h2 mt-3 mb-4">
      {heading}
    </h2>
    <p class="text-body-lg text-text-secondary">
      {description}
    </p>
  </div>

  <div class="relative" data-draw-trigger data-animate="fade-up">
    <!-- Horizontal drawn line threaded through four station dots — shown only at
         lg+, where the four columns have room to breathe. Below lg the phases
         reflow to a 2-up (sm) / stacked (mobile) grid with a top hairline. -->
    <div class="hidden lg:block relative h-4 mb-9">
      <svg class="absolute inset-0 w-full h-full" preserveAspectRatio="none" aria-hidden="true">
        <line
          x1="12.5%" y1="50%" x2="87.5%" y2="50%"
          stroke="var(--color-border-secondary)" stroke-width="1.5" stroke-dasharray="5 5"
          data-draw="scroll"
        />
      </svg>
      <div class="relative grid grid-cols-4 h-full">
        {phasesWithNumbers.map((phase) => (
          <div class="flex items-center justify-center">
            <span
              class:list={[
                'w-3.5 h-3.5 rounded-full ring-4 ring-background-primary',
                phase.last
                  ? 'bg-accent-bronze-bright'
                  : 'bg-surface-raised border border-border-secondary',
              ]}
            ></span>
          </div>
        ))}
      </div>
    </div>

    <!-- Phase columns: stacked (mobile) → 2-up (sm) → 4-up horizontal (lg). -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
      {phasesWithNumbers.map((phase) => (
        <div class="group relative pt-6 lg:pt-0 lg:text-center">
          <!-- top hairline (below lg) that brightens on hover -->
          <span class="lg:hidden absolute top-0 left-0 h-px w-full bg-border-primary overflow-hidden">
            <span class="block h-full w-full origin-left scale-x-0 bg-gradient-to-r from-accent-bronze-bright to-transparent transition-transform duration-500 ease-out group-hover:scale-x-100"></span>
          </span>

          <span class="text-metallic block text-[40px] leading-none font-semibold tabular-nums mb-3">
            {phase.number}
          </span>
          <h3 class="text-h3 font-medium text-white mb-2">
            {phase.title}
          </h3>
          <p class="text-body text-text-secondary lg:max-w-[220px] lg:mx-auto">
            {phase.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</Section>
