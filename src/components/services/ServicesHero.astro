---
// Services hero — a sibling of the Home hero (Hero.astro) and Work hero
// (WorkHero.astro): same layered vocabulary (aura glow, parallax blueprint
// contours, cursor spotlight, clip-reveal headline with a metallic focal line,
// and the xl: single-line re-fit), sized as a page header rather than a full
// viewport hero. A small blueprint detail hides in the contour layer and only
// reveals under the cursor spotlight (easter egg).
interface Props {
  eyebrow?: string;
  eyebrowShort?: string;
  headline?: string;
  headlineLine1?: string;
  headlineLine2?: string;
  subtext?: string;
  meta?: string;
  class?: string;
}

const {
  eyebrow = 'What we do — end to end',
  eyebrowShort = 'What we do',
  headline,
  headlineLine1 = 'Everything from',
  headlineLine2 = 'concept to launch.',
  subtext = 'Strategy, design, build, and the care that comes after — one small team, no handoffs, every detail owned from first wireframe to launch day.',
  meta = 'Strategy · Design · Development · Support',
  class: className,
} = Astro.props;

// A CMS-provided single-string headline overrides the two-line default: the
// final word takes the metallic focal treatment (matches Home/Work/CTA).
let line1 = headlineLine1;
let line2 = headlineLine2;
if (headline && headline.trim()) {
  const m = headline.trim().match(/^([\s\S]*\S)\s+(\S+[.!?…]*)$/);
  if (m) {
    line1 = m[1];
    line2 = m[2];
  } else {
    line1 = '';
    line2 = headline.trim();
  }
}
---

<section
  class:list={['services-hero relative overflow-hidden -mt-12 sm:mt-0', className]}
  data-animate="hero"
  data-spotlight
>
  <!-- Depth glow -->
  <div class="aura w-[620px] h-[440px] top-[-6%] left-1/2 -translate-x-1/2 bg-accent-bronze/[0.10]"></div>

  <!-- Living-blueprint contour layer (parallax + draw-in on load) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.45]"
    aria-hidden="true"
    data-parallax
    data-parallax-speed="-0.1"
  >
    <svg class="w-full h-full" viewBox="0 0 1440 640" fill="none" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <path d="M-40 230 C 260 170, 460 290, 720 230 S 1140 130, 1500 210" stroke="var(--color-border-secondary)" stroke-width="1" data-draw="hero" />
      <path d="M-40 310 C 300 250, 500 370, 780 300 S 1180 190, 1500 280" stroke="var(--color-border-primary)" stroke-width="1" data-draw="hero" />
      <path d="M-40 160 C 240 120, 520 210, 760 160 S 1120 70, 1500 140" stroke="var(--color-border-primary)" stroke-width="1" data-draw="hero" />
    </svg>
  </div>

  <!-- Cursor spotlight -->
  <div
    class="absolute w-[600px] h-[600px] rounded-full opacity-0 pointer-events-none mix-blend-screen -ml-[300px] -mt-[300px]"
    style="background: radial-gradient(circle, rgba(224,162,96,0.12) 0%, rgba(224,162,96,0.05) 35%, transparent 70%);"
    aria-hidden="true"
    data-spotlight-light
  >
  </div>

  <!-- Content -->
  <div class="relative z-10 container-main pt-4 pb-6 sm:pt-16 flex flex-col items-center text-center">
    <!-- Eyebrow pill -->
    <div
      class="inline-flex items-center gap-2 mb-8 px-4 py-1.5 rounded-full border border-border-primary bg-background-secondary/60 backdrop-blur-sm"
      data-hero="eyebrow"
    >
      <span class="w-1.5 h-1.5 shrink-0 rounded-full bg-accent-bronze-bright"></span>
      <span class="text-caption text-text-secondary tracking-wide whitespace-nowrap">
        <span class="sm:hidden">{eyebrowShort}</span>
        <span class="hidden sm:inline">{eyebrow}</span>
      </span>
    </div>

    <!-- Clip-reveal headline; second line metallic. Collapses to one line on xl. -->
    <h1 class="services-headline mb-7" data-hero="headline">
      {line1 && <span class="line"><span class="line-inner text-white">{line1}</span></span>}<span class="line"><span class="line-inner text-metallic metallic-shimmer">{line2}</span></span>
    </h1>

    <!-- Subtext -->
    <p class="text-body-lg text-text-secondary max-w-[620px] mb-7" data-hero="subtext">
      {subtext}
    </p>

    <!-- Meta row -->
    <p class="text-caption uppercase tracking-[0.2em] text-text-muted" data-hero="cta">
      {meta}
    </p>
  </div>
</section>

<style>
  .services-headline {
    font-weight: 600;
    font-size: clamp(2rem, 1.0rem + 4.2vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .services-headline .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .services-headline .line-inner {
    display: block;
  }

  /* Wide desktop: single line, capped so the full string fits the content column. */
  @media (min-width: 1280px) {
    .services-headline {
      font-size: clamp(2.75rem, 1.6rem + 1.9vw, 3.5rem);
      white-space: nowrap;
    }
    .services-headline .line {
      display: inline-block;
      vertical-align: top;
      padding-bottom: 0.12em;
    }
    .services-headline .line + .line {
      margin-left: 0.28em;
    }
  }
</style>
