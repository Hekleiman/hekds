---
import Section from '../ui/Section.astro';
import ServiceIcon from './ServiceIcon.astro';

// "At a glance" overview — the four services as compact cards that jump-link
// down to their detailed rows (#slug). Progressive disclosure: a scannable menu
// first, the deep dive below. Visually distinct from the alternating rows and
// from Home's ServicesIntro.
interface SummaryService {
  title: string;
  description: string;
  features: string[];
  slug?: string;
  icon?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  services: SummaryService[];
  class?: string;
}

const {
  eyebrow = 'Our services',
  heading = 'Four disciplines, one team.',
  description = 'The same two people carry your project the whole way — so strategy, design, build, and support connect seamlessly instead of getting lost in handoffs.',
  services,
  class: className,
} = Astro.props;

const cards = services.map((service, index) => ({
  ...service,
  number: String(index + 1).padStart(2, '0'),
  // A short scan of the key deliverables; the full list lives in the row below.
  highlights: (service.features ?? []).slice(0, 3),
}));
---

<Section class:list={[className]}>
  <!-- Header -->
  <div class="mb-14 lg:mb-16 max-w-[680px]" data-animate="fade-up">
    <span class="text-caption uppercase tracking-[0.2em] text-accent-bronze-bright/80">{eyebrow}</span>
    <h2 class="text-h2 mt-3 mb-4">
      {heading}
    </h2>
    <p class="text-body-lg text-text-secondary">
      {description}
    </p>
  </div>

  <!-- Overview cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 lg:gap-6" data-animate="stagger">
    {cards.map((card) => (
      <a
        href={card.slug ? `#${card.slug}` : undefined}
        class="summary-card group surface-elevated lift flex flex-col p-6 sm:p-7"
      >
        <!-- Top: icon + metallic numeral -->
        <div class="flex items-center justify-between mb-5">
          <span class="w-11 h-11 rounded-full bg-surface-raised border border-border-secondary flex items-center justify-center">
            <ServiceIcon icon={card.icon} />
          </span>
          <span class="text-metallic text-[28px] leading-none font-semibold tabular-nums">{card.number}</span>
        </div>

        <!-- Title + one-line -->
        <h3 class="text-h3-lg font-medium text-white mb-2">{card.title}</h3>
        <p class="text-body text-text-secondary line-clamp-2 mb-5">{card.description}</p>

        <!-- Key deliverables -->
        <ul class="space-y-2 mb-6">
          {card.highlights.map((item) => (
            <li class="flex items-start gap-2.5 text-caption text-text-secondary">
              <svg class="mt-[3px] shrink-0 text-accent-bronze-bright" width="13" height="13" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M2.5 7.5L5.5 10.5L11.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <!-- Jump affordance (pinned to bottom) -->
        <span class="mt-auto inline-flex items-center gap-2 text-caption font-medium text-white">
          <span class="slink-label">See details</span>
          <span class="slink-arrow transition-transform duration-300 ease-out group-hover:translate-y-0.5">↓</span>
        </span>
      </a>
    ))}
  </div>
</Section>

<style>
  .slink-label {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.4s var(--ease-out-expo);
    padding-bottom: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .summary-card:hover .slink-label {
      background-size: 100% 1px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .slink-label,
    .slink-arrow { transition: none; }
  }
</style>
