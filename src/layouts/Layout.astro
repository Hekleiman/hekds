---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings } from '../lib/sanity';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogDescription?: string;
  canonicalPath?: string;
  backgroundImage?: string;
  pageType?: string;
  pageDescription?: string;
  pageName?: string;
}

const {
  title,
  description = 'HEK Design Studio — Designing and building modern websites with clarity and intention.',
  ogImage = '/og-default.png',
  canonicalPath = Astro.url.pathname,
  backgroundImage,
  ogDescription,
  pageType = 'WebPage',
  pageDescription,
  pageName,
} = Astro.props;

const settings = await getSiteSettings();

const siteUrl = 'https://www.hekdesigns.com';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const currentPath = Astro.url.pathname;
const siteName = settings?.siteName || 'HEK Design Studio';

const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "HEK Design Studio",
      "url": siteUrl,
      "logo": `${siteUrl}/favicon.svg`,
      "email": "hello@hekdesign.studio",
      "description": "HEK Design Studio is a boutique web design and development studio serving small businesses and nonprofits. We offer end-to-end design and development from $500 to $3,000+.",
      "founder": [
        { "@id": `${siteUrl}/#harrison-kipper` },
        { "@id": `${siteUrl}/#erik-kleiman` }
      ],
      "sameAs": [
        "https://www.linkedin.com/company/hekdesigns",
        "https://www.instagram.com/hekdesignstudio",
        "https://www.tiktok.com/@hekdesignstudio"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "name": "HEK Design Studio",
      "url": siteUrl,
      "publisher": { "@id": `${siteUrl}/#organization` }
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#harrison-kipper`,
      "name": "Harrison Kipper",
      "jobTitle": "Design Lead",
      "worksFor": { "@id": `${siteUrl}/#organization` },
      "description": "Design Lead at HEK Design Studio with over 8 years of experience in digital design, specializing in user experience and visual systems.",
      "sameAs": []
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#erik-kleiman`,
      "name": "Erik Kleiman",
      "jobTitle": "Development Lead",
      "worksFor": { "@id": `${siteUrl}/#organization` },
      "description": "Development Lead at HEK Design Studio with over a decade of web development experience, specializing in frontend development, performance optimization, and accessibility.",
      "sameAs": []
    }
  ]
};

const pageSchema = {
  "@context": "https://schema.org",
  "@type": pageType,
  "name": pageName || title,
  "description": pageDescription || description,
  "url": canonicalUrl,
  "isPartOf": { "@id": `${siteUrl}/#website` }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Preload the Inter weights used above the fold so text doesn't reflow as
         the font swaps in mid-animation — a key source of entrance "stutter". -->
    <link rel="preload" href="/fonts/inter-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-600.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Entrance guard: hide the elements that animate in *before* first paint so
         they don't flash visible and then jump when GSAP takes over (the mobile
         stutter). Runs synchronously, only when motion is allowed, and arms a
         failsafe so content is never left hidden if the animation bundle fails. -->
    <script is:inline>
      (function () {
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var el = document.documentElement;
          el.classList.add('anim');
          window.__animReveal = function () { el.classList.remove('anim'); };
          window.__animFailsafe = setTimeout(window.__animReveal, 2000);
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription || description} />
    <meta property="og:image" content={new URL(ogImage || '/og-default.png', Astro.site).href} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription || description} />
    <meta name="twitter:image" content={new URL(ogImage || '/og-default.png', Astro.site).href} />

    <title>{title} | {siteName}</title>

    <!-- JSON-LD: Organization graph -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <!-- JSON-LD: Per-page schema -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </head>
  <body class="min-h-screen flex flex-col">
    {backgroundImage && (
      <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
        <img
          src={backgroundImage}
          alt=""
          width="1920"
          height="1080"
          class="w-full h-full object-cover opacity-25 scale-125"
          style="transform-origin: center 30%;"
          loading="eager"
          fetchpriority="low"
          decoding="async"
          data-parallax
          data-parallax-speed="0.08"
        />
        <!-- Depth: darken edges, keep focus toward the center -->
        <div
          class="absolute inset-0"
          style="background: radial-gradient(120% 90% at 50% 22%, transparent 0%, rgba(9,9,11,0.35) 55%, rgba(9,9,11,0.85) 100%);"
        >
        </div>
      </div>
    )}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-white focus:text-black focus:rounded focus:text-sm"
    >
      Skip to content
    </a>
    <Navigation currentPath={currentPath} />
    <main id="main-content" class="flex-1 pt-36">
      <slot />
    </main>
    <Footer
      siteName={settings?.siteName}
      tagline={settings?.tagline}
      contactEmail={settings?.contactEmail}
      copyright={settings?.footerCopyright}
      socialLinks={settings?.socialLinks}
    />

    <script>
      import { initAnimations, cleanupAnimations } from '../scripts/animations';

      // Initialize on first load
      document.addEventListener('DOMContentLoaded', initAnimations);

      // Re-initialize after Astro View Transitions (if using)
      document.addEventListener('astro:page-load', initAnimations);

      // Cleanup before page transition
      document.addEventListener('astro:before-swap', cleanupAnimations);
    </script>
  </body>
</html>
