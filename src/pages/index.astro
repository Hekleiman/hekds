---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import ServicesIntro from '../components/home/ServicesIntro.astro';
import HowWeWork from '../components/home/HowWeWork.astro';
import WhyUs from '../components/home/WhyUs.astro';
import CtaSection from '../components/home/CtaSection.astro';
import { getHomepageContent, type HomepageContent } from '../lib/sanity';

// Fetch CMS content with fallback
let content: HomepageContent | null = null;

try {
  content = await getHomepageContent();
} catch (error) {
  console.error('Failed to fetch homepage from Sanity:', error);
}
---

<Layout
  title="HEK Design Studio — Brand & Web Design"
  description="HEK Design Studio is a boutique web design and development partnership serving small businesses and nonprofits. End-to-end design and development from $500 to $3,000+. Direct collaboration, no handoffs."
  canonicalPath="/"
  backgroundImage="/images/backgrounds/HEK_Homepage_Background.webp"
>
  <script is:inline type="application/ld+json">{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "HEK Design Studio — Web Design and Development",
    "description": "HEK Design Studio is a boutique web design and development studio offering end-to-end services for small businesses and nonprofits, with pricing from $500 to $3,000+.",
    "url": "https://www.hekdesigns.com/",
    "isPartOf": { "@id": "https://www.hekdesigns.com/#website" },
    "about": { "@id": "https://www.hekdesigns.com/#organization" }
  }</script>

  <Hero
    eyebrow={content?.heroEyebrow}
    eyebrowShort={content?.heroEyebrowShort}
    headlineLine1={content?.heroHeadlineLine1}
    headlineLine2={content?.heroHeadlineLine2}
    headlineLine3={content?.heroHeadlineLine3}
    subtext={content?.heroSubtext}
    primaryCta={content?.heroPrimaryCta}
    secondaryCta={content?.heroSecondaryCta}
    pricingLabel={content?.heroPricingLabel}
    pricingValue={content?.heroPricingValue}
    featuredLabel={content?.heroFeaturedLabel}
    featuredWork={content?.featuredWork}
  />

  <ServicesIntro
    eyebrow={content?.servicesHeadline}
    heading={content?.servicesHeading}
    description={content?.servicesDescription}
    services={content?.servicesCards}
  />
  <HowWeWork
    eyebrow={content?.processEyebrow}
    headline={content?.processHeadline}
    description={content?.processDescription}
    steps={content?.processSteps}
  />
  <WhyUs
    eyebrow={content?.whyUsEyebrow}
    headline={content?.whyUsHeadline}
    description={content?.whyUsDescription}
    cards={content?.whyUsCards}
  />
  <CtaSection
    headline={content?.ctaHeadline}
    subtext={content?.ctaSubtext}
    primaryCta={content?.ctaPrimaryCta}
  />
</Layout>
