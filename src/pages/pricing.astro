---
import Layout from '../layouts/Layout.astro';
import PricingHero from '../components/pricing/PricingHero.astro';
import PricingGrid from '../components/pricing/PricingGrid.astro';
import PricingFactors from '../components/pricing/PricingFactors.astro';
import PricingFaq from '../components/pricing/PricingFaq.astro';
import CtaSection from '../components/home/CtaSection.astro';
import { getPricingPageContent, type PricingPageContent, type PricingFactor, type PricingTier } from '../lib/sanity';

// Default pricing factors (fallback)
const defaultFactors: PricingFactor[] = [
  {
    title: 'Project Scope',
    description: 'The size and complexity of the project. A simple marketing site requires less time than a full web application.',
  },
  {
    title: 'Design Complexity',
    description: 'Custom illustrations, animations, and advanced interactions add to the design phase.',
  },
  {
    title: 'Technical Requirements',
    description: 'API integrations, custom functionality, and backend development all impact timeline and cost.',
  },
  {
    title: 'Timeline',
    description: 'Rush projects require rearranging schedules and may come with expedited pricing.',
  },
];

// Default tiers (fallback). Gold is flagged as the featured tier via the existing
// PricingTier.highlighted field (already in the schema + GROQ query) — no new CMS
// field invented; the Sanity singleton can set highlighted on any tier.
const defaultTiers: PricingTier[] = [
  {
    name: 'Bronze Tier',
    price: '$500 – $1,000',
    timeline: '1–2 weeks',
    accentColor: 'bronze',
    features: [
      '1–3 page website',
      'Custom visual design',
      'Responsive build',
      'Basic CMS setup',
      'SEO-ready structure',
    ],
  },
  {
    name: 'Silver Tier',
    price: '$1,500 – $3,000',
    timeline: '2–3 weeks',
    accentColor: 'silver',
    features: [
      'Full website design',
      'Interactive Prototype',
      'Responsive implementation',
      'Basic design system foundations',
      'Analytics setup',
    ],
  },
  {
    name: 'Gold Tier',
    price: 'Starting at $3,000',
    timeline: '3–5 weeks',
    accentColor: 'gold',
    highlighted: true,
    features: [
      'Custom UX and UI design',
      'Front-end development',
      'Simple authentication flows',
      'Basic data handling',
      'Post-launch support',
    ],
  },
];

// FAQ content — the SINGLE source for the visible accordion. Kept verbatim in
// step with the FAQPage JSON-LD below so the two never drift (previously the
// visible copy was a shortened paraphrase that didn't match the structured data).
const faqs = [
  {
    question: 'How much does a website cost at HEK Design Studio?',
    answer:
      'HEK Design Studio offers three pricing tiers: Bronze ($500–$1,000) for 1–3 page websites, Silver ($1,500–$3,000) for full website designs with prototypes and design systems, and Gold (starting at $3,000) for custom UX/UI design with front-end development. Final pricing depends on project scope, design complexity, technical requirements, and timeline.',
  },
  {
    question: 'Does HEK Design Studio offer fixed-price packages?',
    answer:
      "No, HEK Design Studio provides transparent, project-based pricing tailored to each client's specific needs and goals rather than fixed-price packages. The typical price ranges give a sense of investment levels, with actual cost depending on scope, complexity, and timeline.",
  },
  {
    question: "What is included in HEK Design Studio's web design services?",
    answer:
      'Services include strategy and UX design, visual design systems, front-end development, responsive implementation, CMS setup, SEO-ready structure, analytics setup, and post-launch support. Design and development happen in tandem with direct collaboration — no handoffs or middlemen.',
  },
];

// Fetch CMS content
let content: PricingPageContent | null = null;

try {
  content = await getPricingPageContent();
} catch (error) {
  console.error('Failed to fetch pricing page from Sanity:', error);
}

// Use CMS content or fall back to defaults
const factors = content?.factors?.length ? content.factors : defaultFactors;
const tiers = content?.tiers?.length ? content.tiers : defaultTiers;

// Hero copy. The Sanity singleton still carries the pre-redesign hero seed — the
// bare "Pricing" headline and the four-sentence subtext wall — which are byte-for-
// byte the old hardcoded defaults, i.e. nobody deliberately authored them. Treat
// those exact legacy strings as "uncustomized" so the tightened redesign copy
// (PricingHero's own defaults) shows; any genuinely new Sanity value still wins.
// TODO(Harrison): update pricingPage.heroHeadline / heroSubtext in Sanity to bake
// the new copy in, then this guard can be removed.
const LEGACY_HERO_HEADLINE = 'Pricing';
const LEGACY_HERO_SUBTEXT =
  "Every project is unique, so we don't offer fixed-price packages. Instead, we provide transparent, project-based pricing tailored to your specific needs and goals. Below are typical ranges to give you a sense of investment levels. The actual cost depends on scope, complexity, and timeline.";
const heroHeadline =
  content?.heroHeadline && content.heroHeadline.trim() !== LEGACY_HERO_HEADLINE
    ? content.heroHeadline
    : undefined;
const heroSubtext =
  content?.heroSubtext && content.heroSubtext.trim() !== LEGACY_HERO_SUBTEXT
    ? content.heroSubtext
    : undefined;
---

<Layout
  title="Pricing | HEK Design Studio"
  description="Transparent, project-based web design pricing from HEK Design Studio. Bronze tier ($500–$1,000), Silver ($1,500–$3,000), and Gold (starting at $3,000). Custom proposals based on scope and timeline."
  canonicalPath="/pricing"
  backgroundImage="/images/backgrounds/HEK_Pricing_Background.webp"
>
  <script is:inline type="application/ld+json">{
    "@context": "https://schema.org",
    "@type": "Service",
    "provider": { "@id": "https://www.hekdesigns.com/#organization" },
    "name": "Web Design and Development",
    "description": "End-to-end web design and development services for small businesses and nonprofits.",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Web Design Packages",
      "itemListElement": [
        {
          "@type": "Offer",
          "name": "Bronze Tier",
          "description": "1-3 page website with custom visual design, responsive build, basic CMS setup, and SEO-ready structure.",
          "priceSpecification": {
            "@type": "PriceSpecification",
            "price": "500",
            "maxPrice": "1000",
            "priceCurrency": "USD"
          }
        },
        {
          "@type": "Offer",
          "name": "Silver Tier",
          "description": "Full website design with interactive prototype, responsive implementation, basic design system foundations, and analytics setup.",
          "priceSpecification": {
            "@type": "PriceSpecification",
            "price": "1500",
            "maxPrice": "3000",
            "priceCurrency": "USD"
          }
        },
        {
          "@type": "Offer",
          "name": "Gold Tier",
          "description": "Custom UX and UI design with front-end development, simple authentication flows, basic data handling, and post-launch support.",
          "priceSpecification": {
            "@type": "PriceSpecification",
            "price": "3000",
            "priceCurrency": "USD"
          }
        }
      ]
    }
  }</script>
  <script is:inline type="application/ld+json">{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How much does a website cost at HEK Design Studio?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "HEK Design Studio offers three pricing tiers: Bronze ($500–$1,000) for 1–3 page websites, Silver ($1,500–$3,000) for full website designs with prototypes and design systems, and Gold (starting at $3,000) for custom UX/UI design with front-end development. Final pricing depends on project scope, design complexity, technical requirements, and timeline."
        }
      },
      {
        "@type": "Question",
        "name": "Does HEK Design Studio offer fixed-price packages?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No, HEK Design Studio provides transparent, project-based pricing tailored to each client's specific needs and goals rather than fixed-price packages. The typical price ranges give a sense of investment levels, with actual cost depending on scope, complexity, and timeline."
        }
      },
      {
        "@type": "Question",
        "name": "What is included in HEK Design Studio's web design services?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Services include strategy and UX design, visual design systems, front-end development, responsive implementation, CMS setup, SEO-ready structure, analytics setup, and post-launch support. Design and development happen in tandem with direct collaboration — no handoffs or middlemen."
        }
      }
    ]
  }</script>

  <!-- Hero — the three metals introduced above the fold -->
  <PricingHero
    headline={heroHeadline}
    subtext={heroSubtext}
  />

  <!-- Tier row — the page's centerpiece, right after the hero -->
  <PricingGrid
    headline={content?.tiersHeadline}
    tiers={tiers}
    disclaimer={content?.tiersNote}
  />

  <!-- The honest explainer, beneath the numbers -->
  <PricingFactors
    headline={content?.factorsHeadline}
    factors={factors}
  />

  <!-- FAQ (verbatim with the FAQPage JSON-LD above) -->
  <PricingFaq faqs={faqs} />

  <CtaSection
    headline={content?.ctaHeadline || "Let's Discuss Your Project"}
    subtext={content?.ctaSubtext || "The best way to get accurate pricing is to have a conversation. We'll ask about your goals, timeline, and requirements, then provide a detailed proposal."}
    primaryCta={content?.ctaPrimaryCta || { text: 'Get in Touch →', href: '/contact' }}
  />
</Layout>
