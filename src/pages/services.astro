---
import Layout from '../layouts/Layout.astro';
import ServicesHero from '../components/services/ServicesHero.astro';
import ServiceProcess from '../components/services/ServiceProcess.astro';
import ServiceSummary from '../components/services/ServiceSummary.astro';
import ServiceBlock from '../components/services/ServiceBlock.astro';
import CtaSection from '../components/home/CtaSection.astro';
import { getServicesPageContent, type ServicesPageContent, type ServiceItem } from '../lib/sanity';

// Fallback service data. Icon keys are unified on the Home illustration keys
// (strategy | design | code | settings) so each service maps to its bespoke
// blueprint graphic; ServiceBlock also aliases legacy Sanity keys (pen/palette).
const defaultServices: ServiceItem[] = [
  {
    title: 'Strategy & UX Design',
    slug: 'strategy-ux-design',
    icon: 'strategy',
    description:
      'We start every project with clear thinking. User research, information architecture, and wireframing lay the groundwork for success.',
    features: [
      'User research and interviews',
      'Information architecture',
      'User flow mapping',
      'Wireframing and prototyping',
      'Usability testing',
    ],
  },
  {
    title: 'Visual Design & Systems',
    slug: 'visual-design-systems',
    icon: 'design',
    description:
      'From initial concepts to comprehensive design systems, we create cohesive visual languages that scale with your product.',
    features: [
      'Brand identity and guidelines',
      'UI design and mockups',
      'Design system development',
      'Component libraries',
      'Usability testing',
    ],
  },
  {
    title: 'Development & Launch',
    slug: 'development-launch',
    icon: 'code',
    description:
      'Clean, performant code that brings designs to life. We build with modern frameworks and prioritize accessibility.',
    features: [
      'React and modern JavaScript',
      'Responsive implementation',
      'Performance optimization',
      'Accessibility standards',
      'Testing and QA',
    ],
  },
  {
    title: 'Optimization & Support',
    slug: 'optimization-support',
    icon: 'settings',
    description:
      'We continue optimizing your site after launch to improve performance and usability.',
    features: [
      'Performance monitoring and optimization',
      'Ongoing UX and UI refinements',
      'Accessibility audits and updates',
      'Feature and content improvements',
      'Testing, QA, and technical support',
    ],
  },
];

// Fetch CMS content
let content: ServicesPageContent | null = null;

try {
  content = await getServicesPageContent();
} catch (error) {
  console.error('Failed to fetch services page from Sanity:', error);
}

// Use CMS services or fall back to defaults
const services = content?.services?.length ? content.services : defaultServices;

// The Sanity hero singleton still holds the pre-redesign placeholder copy
// (heroHeadline "Services" + the old subtext). Treat that legacy value as
// "unset" so the redesigned two-line hero shows through; a genuine future CMS
// edit (any headline other than the placeholder) still flows through unchanged.
const legacyHero =
  !content?.heroHeadline || content.heroHeadline.trim().toLowerCase() === 'services';
const heroHeadline = legacyHero ? undefined : content?.heroHeadline;
const heroSubtext = legacyHero ? undefined : content?.heroSubtext;
---

<Layout
  title="Services | HEK Design Studio"
  description="Full-service web design and development from HEK Design Studio. Strategy and UX design, visual design systems, front-end development, and post-launch optimization for small businesses and nonprofits."
  canonicalPath="/services"
  backgroundImage="/images/backgrounds/HEK_Services_Background.webp"
>
  <script is:inline type="application/ld+json">{
    "@context": "https://schema.org",
    "@type": "Service",
    "provider": { "@id": "https://www.hekdesigns.com/#organization" },
    "name": "Web Design and Development Services",
    "description": "Full-service web design and development including strategy, UX design, visual design systems, front-end development, and ongoing optimization.",
    "serviceType": "Web Design and Development",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Design and Development Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Strategy & UX Design",
            "description": "User research, information architecture, user flow mapping, wireframing and prototyping, and usability testing."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Visual Design & Systems",
            "description": "Brand identity and guidelines, UI design and mockups, design system development, and component libraries."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Development & Launch",
            "description": "React and modern JavaScript, responsive implementation, performance optimization, accessibility standards, and testing."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Optimization & Support",
            "description": "Performance monitoring, ongoing UX and UI refinements, accessibility audits, feature improvements, and technical support."
          }
        }
      ]
    }
  }</script>

  <ServicesHero
    headline={heroHeadline}
    subtext={heroSubtext}
  />

  <!-- How a project runs — the engagement's process, as a drawn horizontal
       timeline (unique to this page; Home has no equivalent). -->
  <ServiceProcess />

  <!-- The four services, at a glance — a scannable overview that jump-links down
       to each detailed row below (progressive disclosure). -->
  <ServiceSummary services={services} />

  <!-- Each service, in depth — the four alternating rows stitched together by
       the drawn-in blueprint connector spine. -->
  <section class="py-services scroll-mt-32">
    <div class="container-main">
      <!-- Lighter header (the framing intro lives in the overview above) -->
      <div class="mb-16 lg:mb-20 max-w-[680px]" data-animate="fade-up">
        <span class="text-caption uppercase tracking-[0.2em] text-accent-bronze-bright/80">In depth</span>
        <h2 class="text-h2 mt-3 mb-4">
          A closer look at <span class="text-metallic-bronze">each.</span>
        </h2>
        <p class="text-body-lg text-text-secondary">
          What every discipline covers, what you get, and how it fits into the whole.
        </p>
      </div>

      <!-- Rows + connecting blueprint spine -->
      <div class="relative" data-draw-trigger>
        <!-- Connecting lines (draw in on scroll) — the process, stitched -->
        <div class="connecting-lines absolute inset-0 pointer-events-none hidden lg:block" aria-hidden="true">
          <svg class="w-full h-full" preserveAspectRatio="none">
            <line x1="75%" y1="18%" x2="25%" y2="30%" stroke="var(--color-border-secondary)" stroke-width="1.5" stroke-dasharray="5 5" data-draw="scroll" />
            <line x1="25%" y1="44%" x2="75%" y2="56%" stroke="var(--color-border-secondary)" stroke-width="1.5" stroke-dasharray="5 5" data-draw="scroll" />
            <line x1="75%" y1="70%" x2="25%" y2="82%" stroke="var(--color-border-secondary)" stroke-width="1.5" stroke-dasharray="5 5" data-draw="scroll" />
          </svg>
        </div>

        <div class="space-y-24 lg:space-y-32 relative z-10">
          {services.map((service, index) => (
            <ServiceBlock
              title={service.title}
              slug={service.slug}
              description={service.description}
              features={service.features}
              icon={service.icon}
              index={index}
              reversed={index % 2 === 1}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaSection
    headline={content?.ctaHeadline || 'Not sure which service you need?'}
    subtext={content?.ctaSubtext || "Let's talk about your project and figure out the best approach together. Most clients benefit from a combination of our services."}
    primaryCta={content?.ctaPrimaryCta || { text: 'Get in Touch', href: '/contact' }}
  />
</Layout>

<style>
  .py-services {
    padding-top: clamp(48px, 7vw, 80px);
    padding-bottom: clamp(64px, 10vw, var(--spacing-section));
  }
</style>
